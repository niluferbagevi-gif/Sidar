# Sidar — Minimal .env örneği
# Kullanım:
#   cp .env.example .env
#   uv run sidar init   # boş/zayıf local secret'ları güvenli üretir
#
# Yükleme sırası / override:
#   .env < .env.advanced < .env.${SIDAR_ENV} < ~/.sidar_keys.env < DOTENV_FILE
# İleri seviye ayarlar için .env.advanced.example dosyasını inceleyin.

# ─── Ortam ve AI sağlayıcı ───────────────────
SIDAR_ENV=development
AI_PROVIDER=ollama
CODING_MODEL=qwen2.5-coder:7b
TEXT_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434/api

# Bulut sağlayıcıları opsiyoneldir; yalnız kullandıklarınızı doldurun.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ─── Temel güvenlik ──────────────────────────
SIDAR_ACCESS_LEVEL=sandbox
SIDAR_API_KEY=
SIDAR_JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_TTL_DAYS=7
SIDAR_MEMORY_ENCRYPTION_KEY=

# ─── PostgreSQL kökleri ──────────────────────
# DATABASE_URL yazmayın; config.py bu köklerden dinamik türetir.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sidar
POSTGRES_USER=sidar
POSTGRES_PASSWORD=
DB_SCHEMA_VERSION_TABLE=schema_versions

# ─── Redis temel bağlantısı ──────────────────
SIDAR_REDIS_URL=redis://localhost:6379/0
SIDAR_REDIS_MAX_CONNECTIONS=50

# ─── Web arayüzü ─────────────────────────────
# Güvenli varsayılan: 127.0.0.1. Public bind için reverse proxy + API key kullanın.
SIDAR_WEB_HOST=127.0.0.1
# Public bind güvenlik kilidi: 0.0.0.0 için açık onay gerekir.
SIDAR_ALLOW_PUBLIC_BIND=false
SIDAR_WEB_PORT=7860
