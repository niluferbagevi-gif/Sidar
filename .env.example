# Sidar Project — Minimal çevre değişkenleri
# Başlangıç: cp .env.example .env
# Gelişmiş ayarlar için: .env.advanced.example

# ─── Ortam ───────────────────────────────────
SIDAR_ENV=development
APP_RUNTIME_MODE=development
SIDAR_KEYS_FILE=~/.sidar_keys.env
# Gerçek anahtarlar SIDAR_KEYS_FILE'da tutulur; repo içine çözümlenen yollar reddedilir.
# Env dosyalarına materyalize etmek için bilinçli opt-in:
SIDAR_MATERIALIZE_REAL_KEYS_TO_ENV=0

# ─── AI sağlayıcısı (minimal) ─────────────────
AI_PROVIDER=ollama
CODING_MODEL=qwen2.5-coder:7b
TEXT_MODEL=gemma2:9b
OLLAMA_URL=http://localhost:11434/api
OLLAMA_NUM_BATCH=2048
OLLAMA_NUM_CTX=8192
OPENAI_API_KEY=

# ─── Donanım & GPU (CPU-only için güvenli varsayılan) ─────────────────
USE_GPU=false
REQUIRE_GPU=false
GPU_MIXED_PRECISION=false

# ─── Veritabanı (minimal) ─────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sidar
POSTGRES_USER=sidar
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ─── Redis ────────────────────────────────────
SIDAR_REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=change-me-to-a-strong-password

# ─── Güvenlik ─────────────────────────────────
ACCESS_LEVEL=sandbox
PROMPT_GUARD_ENABLED=true
GUARDRAILS_REQUIRED=false
API_KEY=change-me-api-key
JWT_SECRET_KEY=change-me-jwt-secret-32-plus-chars
JWT_ALGORITHM=HS256
JWT_TTL_DAYS=7

# ─── Kod yürütme sandbox'ı ───────────────────
SIDAR_CODE_EXECUTION_BACKEND=docker
CODE_EXECUTION_BACKEND=docker
DOCKER_AUTODETECT=true
