# Sidar Project — Temel çevre değişkenleri
# Başlangıç: cp .env.example .env
# Gelişmiş ayarlar için .env.advanced içinden gereken anahtarları ayrı bir
# override dosyasına kopyalayın ve DOTENV_FILE=.env.<dosya> ile yükleyin.

# ─── Ortam ───────────────────────────────────
SIDAR_ENV=development
DOTENV_FILE=
# Kullanıcıya özel gizli anahtar dosyası; repoya eklemeyin.
SIDAR_KEYS_FILE=~/.sidar_keys.env

# ─── AI Sağlayıcıları ─────────────────────────
AI_PROVIDER=ollama
CODING_MODEL=qwen2.5-coder:7b
TEXT_MODEL=gemma2:9b
OLLAMA_URL=http://localhost:11434/api
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
LITELLM_GATEWAY_URL=
LITELLM_API_KEY=
LITELLM_MODEL=

# ─── PostgreSQL kök bilgileri ─────────────────
# DATABASE_URL/SIDAR_CONTAINER_DATABASE_URL boşsa config.py bu parçalardan üretir.
POSTGRES_HOST=localhost
POSTGRES_CONTAINER_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sidar
POSTGRES_USER=sidar
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ─── Redis temel bağlantısı ───────────────────
SIDAR_REDIS_URL=redis://localhost:6379/0
SIDAR_REDIS_MAX_CONNECTIONS=50

# ─── Güvenlik ─────────────────────────────────
ACCESS_LEVEL=sandbox
API_KEY=change-me-api-key
JWT_SECRET_KEY=change-me-jwt-secret-32-plus-chars
JWT_ALGORITHM=HS256
JWT_TTL_DAYS=7
MEMORY_ENCRYPTION_KEY=

# ─── VRAM Yönetimi (yerel LLM kullanımı için) ─
# Local LLM (Ollama) + ChromaDB embedding aynı GPU'da çalışınca VRAM bölüşülür.
# .env.advanced bu üç değerin tam dokümantasyonunu içerir; aşağıdaki yorumlar
# kısa özet — kendi donanım limitlerinize göre uncomment edip düzenleyin.
# Yüksek VRAM'li (≥16 GB) ayrık GPU için 0.8/0.6/0.3 makul başlangıçtır.
# WSL2 üzerinde ya da düşük VRAM'li (8–12 GB) GPU'larda Windows host VRAM'ini
# de paylaştığınız için 0.5–0.6 toplam ile başlamak OOM riskini azaltır.
# NOT: LLM + RAG toplamı 1.0'ı aşarsa config.py otomatik olarak 0.8 toplamına
# normalize eder (uyarı logu üretir) — bu davranış kapatılamaz; örnek
# verilen her senaryoda toplam ≤ 0.9 tutmanız önerilir.
# GPU_MEMORY_FRACTION=0.8
# LLM_GPU_MEMORY_FRACTION=0.6
# RAG_GPU_MEMORY_FRACTION=0.3
