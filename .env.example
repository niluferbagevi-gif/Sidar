# Sidar Project — Temel çevre değişkenleri
# Başlangıç: cp .env.example .env
# Gelişmiş ayarlar için .env.advanced içinden gereken anahtarları ayrı bir
# override dosyasına kopyalayın ve DOTENV_FILE=.env.<dosya> ile yükleyin.

# ─── Ortam ───────────────────────────────────
SIDAR_ENV=development
DOTENV_FILE=
# Kullanıcıya özel gizli anahtar dosyası; repoya eklemeyin.
SIDAR_KEYS_FILE=~/.sidar_keys.env

# ─── GPU ayarları ─────────────────────────────
USE_GPU=true
GPU_MIXED_PRECISION=false
COMPOSE_PROFILES=gpu
DOCKER_RUNTIME=nvidia
# Ajan sandbox REPL/pytest için kullanılacak Docker imajı (boş bırakılırsa Dockerfile'dan build edilmiş sidar-gpu:latest aranır)
DOCKER_TEST_IMAGE=sidar-gpu:latest

# ─── AI Sağlayıcıları ─────────────────────────
AI_PROVIDER=ollama
CODING_MODEL=qwen2.5-coder:7b
TEXT_MODEL=gemma2:9b
OLLAMA_URL=http://localhost:11434/api
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
LITELLM_GATEWAY_URL=
LITELLM_API_KEY=
LITELLM_MODEL=

# ─── PostgreSQL kök bilgileri ─────────────────
# DATABASE_URL/SIDAR_CONTAINER_DATABASE_URL aktif tanımlı değilse config.py bu parçalardan üretir.
POSTGRES_HOST=127.0.0.1
POSTGRES_CONTAINER_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sidar
POSTGRES_USER=sidar
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ─── Redis temel bağlantısı ───────────────────
SIDAR_REDIS_URL=redis://localhost:6379/0
SIDAR_REDIS_MAX_CONNECTIONS=50

# ─── Güvenlik ─────────────────────────────────
ACCESS_LEVEL=sandbox
API_KEY=change-me-api-key
JWT_SECRET_KEY=change-me-jwt-secret-32-plus-chars
JWT_ALGORITHM=HS256
JWT_TTL_DAYS=7
MEMORY_ENCRYPTION_KEY=
