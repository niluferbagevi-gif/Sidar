# Sidar Project — Minimal çevre değişkenleri
# Başlangıç: cp .env.example .env
# Gelişmiş ayarlar için: .env.advanced.example

# ─── Ortam ───────────────────────────────────
SIDAR_ENV=development
APP_RUNTIME_MODE=development
SIDAR_KEYS_FILE=~/.sidar_keys.env

# ─── AI sağlayıcısı (minimal) ─────────────────
AI_PROVIDER=ollama
CODING_MODEL=qwen2.5-coder:7b
TEXT_MODEL=gemma2:9b
OLLAMA_URL=http://localhost:11434/api
# Long prompt assertion fix: 8192 ctx ile llama.cpp n_batch=512 varsayılanına düşmemek için 2048.
OLLAMA_NUM_BATCH=2048
OLLAMA_NUM_CTX=8192
OPENAI_API_KEY=


# ─── Donanım & GPU (CPU-only için güvenli varsayılan) ─────────────────
# Kurulum script'i GPU tespit ederse USE_GPU=true / REQUIRE_GPU=true yazabilir.
USE_GPU=false
REQUIRE_GPU=false
GPU_MIXED_PRECISION=false

# ─── Veritabanı (minimal) ─────────────────────
# DATABASE_URL bilinçli olarak burada tek kaynak yapılmaz; Sidar ve Alembic
# POSTGRES_* parçalarından runtime DSN'i türetir. Yalnız özel DSN gerekiyorsa
# .env.advanced.example içindeki DATABASE_URL notlarını izleyin.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sidar
POSTGRES_USER=sidar
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ─── Redis ────────────────────────────────────
# Yeni kurulumlarda canonical key SIDAR_REDIS_URL'dir; legacy REDIS_URL alias
# olarak okunmaya devam eder.
SIDAR_REDIS_URL=redis://localhost:6379/0

# ─── Güvenlik ─────────────────────────────────
ACCESS_LEVEL=sandbox
API_KEY=change-me-api-key
JWT_SECRET_KEY=change-me-jwt-secret-32-plus-chars
JWT_ALGORITHM=HS256
JWT_TTL_DAYS=7
