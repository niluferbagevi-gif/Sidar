# ─────────────────────────────────────────────
# Sidar Project — Minimal Çevre Değişkenleri Örneği
# Bu dosyayı .env olarak kopyalayın veya güvenli secret üretimiyle başlatın:
#   uv run sidar init
#
# Sadece Sidar'ı ayağa kaldırmak için gereken temel ayarlar burada tutulur:
# AI sağlayıcısı, veritabanı kökleri ve temel güvenlik anahtarları.
# İleri seviye/opsiyonel ayarlar için .env.advanced.example dosyasını inceleyin.
# İsterseniz `uv run sidar init --with-advanced` ile ayrı .env.advanced oluşturabilirsiniz.
# ─────────────────────────────────────────────

# ─── AI Sağlayıcısı ──────────────────────────
# "ollama" (yerel), "gemini" (bulut), "openai" (bulut) veya "anthropic" (bulut)
AI_PROVIDER=ollama

# ─── Ollama (varsayılan yerel sağlayıcı) ──────
# Docker içinden host Ollama kullanacaksanız Windows/Mac: http://host.docker.internal:11434/api
# Linux Docker host IP örneği: http://172.17.0.1:11434/api
OLLAMA_URL=http://localhost:11434/api

# Varsayılan ve önerilen yerel coding modeli qwen2.5-coder:7b
CODING_MODEL=qwen2.5-coder:7b
TEXT_MODEL=llama3.1:8b

# ─── Bulut sağlayıcıları (opsiyonel) ──────────
# AI_PROVIDER değerini ilgili sağlayıcıya alırsanız gerçek panel anahtarınızı girin.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ─── Erişim Seviyesi ─────────────────────────
# restricted: yalnızca okuma/denetim; sandbox: güvenli geliştirme; full: proje dosyalarını düzenleme
SIDAR_ACCESS_LEVEL=sandbox

# ─── Temel API/Web Güvenliği ─────────────────
# `uv run sidar init` veya `uv run sidar generate-keys` boş/zayıf değerleri güvenli üretir.
SIDAR_API_KEY=
SIDAR_JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_TTL_DAYS=7

# ─── Veritabanı ve RAG Arka Ucu ───────────────
# Sidar DATABASE_URL değerini config.py içinde bu kök POSTGRES_* değişkenlerinden türetir.
# Docker Compose uygulama servisleri POSTGRES_HOST=postgres override'ı ile aynı köklerden
# container içi bağlantıyı üretir; .env içinde ayrıca DATABASE_URL tutmayın.
RAG_VECTOR_BACKEND=pgvector
POSTGRES_HOST=localhost
POSTGRES_DB=sidar
POSTGRES_USER=sidar
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DB_SCHEMA_VERSION_TABLE=schema_versions
ANONYMIZED_TELEMETRY=false

# ─── Hafıza Şifrelemesi ──────────────────────
# Boş bırakılırsa geliştirme için şifreleme devre dışıdır.
# Kurumsal/hassas kullanımda `uv run sidar generate-keys` ile Fernet anahtarı üretin.
SIDAR_MEMORY_ENCRYPTION_KEY=

# ─── Web Arayüzü ve Ağ ───────────────────────
# Güvenli varsayılan 127.0.0.1; 0.0.0.0 yalnız ters proxy/API key ile bilinçli kullanılmalıdır.
SIDAR_WEB_HOST=127.0.0.1
SIDAR_WEB_PORT=7860
WEB_GPU_PORT=7861

# ─── Güvenli Kod Çalıştırma Sandbox'ı ─────────
SIDAR_DOCKER_PYTHON_IMAGE=python:3.11-slim
SIDAR_DOCKER_TEST_IMAGE=sidar:latest
SIDAR_DOCKER_EXEC_TIMEOUT=30
SIDAR_DOCKER_REQUIRED=false
SANDBOX_NETWORK=bridge
