{
  // checkJs is intentionally false: the app is almost entirely .jsx/.js (one
  // .ts file exists, src/hooks/useThrottledStream.ts). `npm run typecheck`
  // therefore only type-checks that one file plus TS-side module resolution
  // -- it does not type-check component/hook logic. Do not read a passing
  // `npm run typecheck` as type safety for the .jsx/.js tree; use it only as
  // a regression gate for genuinely-typed (.ts/.tsx) code.
  // Tracking: the Frontend bakım ekibi owns the incremental .jsx -> .tsx
  // campaign through 2027-03-31; see
  // docs/development/frontend-typescript-migration.md. Enabling checkJs=true
  // today surfaces ~3000 pre-existing errors and cannot be flipped at once.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "e2e"]
}
