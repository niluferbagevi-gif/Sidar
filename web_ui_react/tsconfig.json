{
  // checkJs is intentionally false: the app is still predominantly .jsx/.js.
  // `npm run typecheck` checks the incrementally migrated .ts/.tsx surface
  // plus TS-side module resolution
  // -- it does not type-check component/hook logic. Do not read a passing
  // `npm run typecheck` as type safety for the .jsx/.js tree; use it only as
  // a regression gate for genuinely-typed (.ts/.tsx) code.
  // Tracking: the owned, dated incremental migration campaign and its current
  // gate scope live in docs/REFACTOR_PLAN.md. Enabling checkJs=true today surfaces
  // ~3000 pre-existing errors
  // across the untyped tree and cannot be flipped without that migration.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "e2e"]
}
