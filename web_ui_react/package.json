{
  "name": "sidar-web-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx --report-unused-disable-directives",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=moderate",
    "audit:high": "node ../scripts/npm_audit_safe.js --level=high --retries=2",
    "audit:moderate": "npm audit --audit-level=moderate",
    "deps:update": "npm install",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:critical": "vitest run src/lib/api.test.js src/lib/routerShim.test.jsx",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/chat-websocket.spec.js",
    "test:e2e:headed": "playwright test --headed",
    "build:budget": "npm run build && node scripts/check-bundle-budget.mjs",
    "bundle:budget": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "highlight.js": "~11.11.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.30.4",
    "remark-gfm": "^4.0.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": ">=1.60.0 <1.62.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^6.0.11",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.4",
    "ws": "^8.21.0"
  }
}
