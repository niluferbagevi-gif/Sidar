# ─────────────────────────────────────────────
# Sidar — Test Ortamı Çevre Değişkenleri Şablonu
#
# Bu dosya `run_tests.sh` çalıştırıldığında otomatik olarak
# `.env.test` adıyla kopyalanır (eğer henüz yoksa). İhtiyacınıza göre
# `.env.test` üzerinde düzenleme yapabilirsiniz; bu örnek dosyaya
# gerçek sırlar (gerçek API key'leri, üretim parolaları vb.)
# YAZMAYIN — sürüm kontrolüne giren bir dosyadır.
#
# Üretim/dev `.env` dosyasından farklı olarak burada sadece testlerin
# gerektirdiği minimum değişkenler tutulur. Tam liste için `.env.example`
# dosyasına bakın.
# ─────────────────────────────────────────────

# ─── Ortam İşareti ───────────────────────────
# config.py SIDAR_ENV=test olduğunda yalnızca .env.test'i öncelikli yükler.
SIDAR_ENV=test

# ─── PostgreSQL (test veritabanı) ─────────────
# run_tests.sh bu değerleri `prepare_test_database` aşamasında okur ve
# DATABASE_URL'i postgresql+asyncpg://USER:PASSWORD@HOST:PORT/NAME olarak
# türetir. Docker compose üzerinde `postgres` servisi çalışıyor olmalı.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sidar
POSTGRES_PASSWORD=sidar
POSTGRES_DB=sidar
TEST_DATABASE_NAME=sidar_test
# TEST_DATABASE_USER ve TEST_DATABASE_PASSWORD belirtilmezse POSTGRES_USER /
# POSTGRES_PASSWORD değerleri kullanılır.
# TEST_DATABASE_USER=
# TEST_DATABASE_PASSWORD=
# Her test koşumu öncesi test DB'sini sıfırlamak için 1 (varsayılan).
RESET_TEST_DATABASE=1

# ─── Redis (test) ─────────────────────────────
# Çoğu test fakeredis ile çalışır; gerçek Redis sadece entegrasyon testleri
# için gereklidir. docker-compose.yml içindeki `redis` servisi yeterlidir.
REDIS_URL=redis://localhost:6379/15
REDIS_MAX_CONNECTIONS=5

# ─── LLM Sağlayıcı Sahte Anahtarları ──────────
# Testler bulut LLM çağrısı yapmaz; conftest.py monkeypatch ile sahte
# anahtarlar enjekte eder. Buradaki değerler yalnızca import-zamanı
# doğrulamalarını geçmek içindir. GERÇEK ANAHTAR YAZMAYIN.
AI_PROVIDER=ollama
GEMINI_API_KEY=test_key
GOOGLE_API_KEY=test_key
OPENAI_API_KEY=test_key
ANTHROPIC_API_KEY=test_key

# ─── Ollama (yerel test koşumlarında) ─────────
# GPU/integration testleri kapalıyken bu değerlere dokunmaya gerek yok.
OLLAMA_URL=http://localhost:11434/api
OLLAMA_TIMEOUT=60

# GPU benchmark ısınma turları (özellikle laptop GPU'larda P-state stabilizasyonu için)
GPU_BENCH_WARMUP_ROUNDS=8

# ─── Erişim ve Güvenlik ───────────────────────
# Testte auth katmanını devre dışı bırakmak için boş bırakılabilir; ancak
# auth-related testler için sabit, deterministik bir değer veriyoruz.
ACCESS_LEVEL=sandbox
API_KEY=test_api_key_do_not_use_in_production
AUTONOMY_WEBHOOK_SECRET=test_webhook_secret

# config.py SIDAR_ENV=production olmadığı sürece zorunlu değildir, ancak
# memory encryption kapsayan testler için sabit anahtar gerekir.
# 32 byte base64 değer (test amaçlı sabit, sırrı temsil etmez).
MEMORY_ENCRYPTION_KEY=dGVzdF9tZW1vcnlfZW5jcnlwdGlvbl9rZXlfMzJieXRlcw==

# ─── Benchmark Regresyon Takibi ───────────────
# Test koşumları benchmark kaydını otomatik baseline karşılaştırmasına sokar.
RUN_BENCHMARKS=required
BENCHMARK_ENABLE_COMPARE=1
BENCHMARK_COMPARE_NAME=baseline
BENCHMARK_COMPARE_REQUIRED=0

# ─── Test Koşumu Ayarları ────────────────────
# Bazı testler bu bayraklara bakar; varsayılanlar yeterlidir, açıklama
# amacıyla tutulmuştur.
TEST_REDIS_DECODE_RESPONSES=true
# Freezegun'ın atlaması istenen ek modüller (virgülle ayrılmış).
# TEST_FREEZEGUN_IGNORE_MODULES=
