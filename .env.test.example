# ─────────────────────────────────────────────
# Sidar — Test Ortamı Çevre Değişkenleri Şablonu
# Sidar, izole test DATABASE_URL değerini çalışma zamanında üretir;
# DATABASE_URL'i burada açıkça tanımlamayın.
#
# Bu dosya `run_tests.sh` çalıştırıldığında otomatik olarak
# `.env.test` adıyla kopyalanır (eğer henüz yoksa). İhtiyacınıza göre
# `.env.test` üzerinde düzenleme yapabilirsiniz; bu örnek dosyaya
# gerçek sırlar (gerçek API key'leri, üretim parolaları vb.)
# YAZMAYIN — sürüm kontrolüne giren bir dosyadır.
#
# Üretim/dev `.env` dosyasından farklı olarak burada sadece testlerin
# gerektirdiği minimum değişkenler tutulur. Gelişmiş/tam liste için `.env.advanced`
# dosyasına bakın.
# ─────────────────────────────────────────────

# ─── Ortam İşareti ───────────────────────────
# config.py SIDAR_ENV=test olduğunda yalnızca .env.test'i öncelikli yükler.
SIDAR_ENV=test

# ─── PostgreSQL (test veritabanı) ─────────────
# run_tests.sh bu değerleri `prepare_test_database` aşamasında okur ve
# izole test DATABASE_URL değerini `postgresql+asyncpg://...` formatında
# çalışma zamanında üretir. Bu nedenle test koşumu öncesinde postgres runtime
# bağımlılıkları kurulu olmalıdır (öneri: `uv sync --frozen --all-extras`
# veya minimum `uv sync --extra postgres`). Docker compose üzerinde `postgres`
# servisi çalışıyor olmalı.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=sidar
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=sidar
TEST_DATABASE_NAME=sidar_test
# POSTGRES_PASSWORD=__GENERATE__ sentineli .env.test oluşturulurken güçlü, lokal
# bir parolaya çevrilir. TEST_DATABASE_USER ve TEST_DATABASE_PASSWORD
# belirtilmezse POSTGRES_USER / POSTGRES_PASSWORD değerleri kullanılır.
# TEST_DATABASE_USER=
# TEST_DATABASE_PASSWORD=
# PostgreSQL benchmark varyantını etkinleştirmek için örnek DSN. Boş bırakılırsa
# tests/performance/test_benchmark.py yalnız SQLite varyantını koşturur.
# SIDAR_BENCHMARK_POSTGRES_URL=postgresql+asyncpg://sidar:change-me@127.0.0.1:5432/sidar_test
# Her test koşumu öncesi test DB'sini sıfırlamak için 1 (varsayılan).
RESET_TEST_DATABASE=1

# ─── Redis (test) ─────────────────────────────
# Çoğu test fakeredis ile çalışır; gerçek Redis sadece entegrasyon testleri
# için gereklidir. docker-compose.yml içindeki `redis` servisi yeterlidir.
REDIS_URL=redis://localhost:6379/15
REDIS_MAX_CONNECTIONS=5

# ─── Gerçek Secret Overlay Opt-in ───────────────
# Genel unit/smoke/integration testleri gerçek kullanıcı secret dosyasını
# yüklemez. Secret zincirini özel olarak doğrulayan testlerde geçici bir
# SIDAR_KEYS_FILE ile birlikte SIDAR_TEST_LOAD_REAL_KEYS=1 verin.
# SIDAR_TEST_LOAD_REAL_KEYS=0
# SIDAR_KEYS_FILE=

# ─── LLM Sağlayıcı Sahte Anahtarları ──────────
# Testler bulut LLM çağrısı yapmaz; conftest.py monkeypatch ile sahte
# anahtarlar enjekte eder. Buradaki değerler yalnızca import-zamanı
# doğrulamalarını geçmek içindir. GERÇEK ANAHTAR YAZMAYIN.
AI_PROVIDER=ollama
GEMINI_API_KEY=test_key
GOOGLE_API_KEY=test_key
OPENAI_API_KEY=test_key
ANTHROPIC_API_KEY=test_key

# ─── Ollama (yerel test koşumlarında) ─────────
# GPU/integration testleri kapalıyken bu değerlere dokunmaya gerek yok.
OLLAMA_URL=http://localhost:11434/api
OLLAMA_TIMEOUT=60
# Long prompt assertion fix: GPU/integration testlerinde uzun promptlar için güvenli batch.
OLLAMA_NUM_BATCH=2048
OLLAMA_NUM_CTX=8192
# CPU-only test koşumları ve varsayılan CI için güvenli değer. GPU testleri nvidia-smi tespit edilirse run_tests.sh tarafından otomatik açılır.
USE_GPU=false
REQUIRE_GPU=false

# GPU benchmark ısınma turları (özellikle laptop GPU'larda P-state stabilizasyonu için)
GPU_BENCH_WARMUP_ROUNDS=8

# ─── Erişim ve Güvenlik ───────────────────────
# Testte auth katmanını devre dışı bırakmak için boş bırakılabilir; ancak
# auth-related testler için sabit, deterministik bir değer veriyoruz.
ACCESS_LEVEL=sandbox
API_KEY=test_api_key_do_not_use_in_production
AUTONOMY_WEBHOOK_SECRET=test_webhook_secret

# config.py SIDAR_ENV=production olmadığı sürece zorunlu değildir, ancak
# memory encryption kapsayan testler için sabit anahtar gerekir.
# 32 byte base64 değer (test amaçlı sabit, sırrı temsil etmez).
MEMORY_ENCRYPTION_KEY=zuysQ-vCjie2thC__tksh8zIl0F0V1MfND7opBpVHT8=

# Benchmark regresyon karşılaştırması varsayılan olarak aktiftir.
# Restore edilmiş baseline yoksa run_tests.sh önce --benchmark-save ile baseline üretir;
# baseline yokluğunu fail etmek isteyen sıkı CI hatları BENCHMARK_COMPARE_REQUIRED=1 yapabilir.
BENCHMARK_ENABLE_COMPARE=1
BENCHMARK_COMPARE_REQUIRED=0
# CI profilinde varsayılan 1, yerelde 0: baseline her iki profilde raporlanır ancak
# yerel jitter varsayılan olarak hard-fail üretmez. Sabit runner veya özel kampanya için 1 yapın.
BENCHMARK_ENFORCE_COMPARE=
# Benchmark fazının genel sonucu CI profilinde varsayılan hard-fail, yerelde flake-soft-fail olur.
# Sabit yerel runner üzerinde sıkı doğrulama için 1 yapın.
BENCHMARK_ENFORCE_RESULT=
# Enforcement açıkken boş bırakılırsa run_tests.sh yerelde mean:15%, CI profilinde mean:10% uygular.
BENCHMARK_COMPARE_FAIL=
# Benchmark ölçümlerinde GC kapatılır ve kalibrasyon warmup'ı etkinleştirilir.
BENCHMARK_DISABLE_GC=1
BENCHMARK_WARMUP=on
BENCHMARK_WARMUP_ITERATIONS=100000
# Yerel/PR GPU benchmarklarında hızlı smoke; nightly trend için full kullanın.
RUN_GPU_BENCHMARKS=smoke
BENCHMARK_COMPARE_NAME=baseline

# Coverage ratchet günlük local/CI akışında varsayılan olarak %99 cap ile 1 puanlık
# tampon bırakır. Stabil bir runner üzerinde %100 gate'i bilinçli açmak için 1 yapın.
COVERAGE_STRICT_LOCAL_RATCHET=0

# Frontend Playwright E2E: ilk hatada varsayılan olarak bir kez retry yapılır.
# RETRY_ON_FAIL=1 kısa adı da desteklenir; namespaced değer önceliklidir.
FRONTEND_E2E_RETRY_ON_FAIL=1
# CI profilinde varsayılan hard-fail, yerelde WSL2 flake'leri için soft-fail raporudur.
FRONTEND_E2E_ENFORCE_RESULT=

# ─── Test Koşumu Ayarları ────────────────────
# Bazı testler bu bayraklara bakar; varsayılanlar yeterlidir, açıklama
# amacıyla tutulmuştur.
TEST_REDIS_DECODE_RESPONSES=true
# Freezegun'ın atlaması istenen ek modüller (virgülle ayrılmış).
# TEST_FREEZEGUN_IGNORE_MODULES=
