{
  "name": "Sidar Dev Container",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "64gb",
    "gpu": "optional"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "username": "vscode",
      "upgradePackages": false
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    }
  },
  "containerEnv": {
    "UV_LINK_MODE": "copy",
    "UV_PROJECT_ENVIRONMENT": ".venv-container",
    "SIDAR_PYTHON_VERSION": "3.11",
    "CODING_MODEL": "qwen2.5-coder:7b",
    "OLLAMA_REQUIRED_MODELS": "qwen2.5-coder:7b",
    "OLLAMA_MODEL_SYNC": "auto",
    "AUTONOMOUS_LOOP_COVERAGE_PROFILE": "full",
    "AUTONOMOUS_LOOP_OPERATION_PROFILE": "coverage-campaign",
    "ENABLE_GPU_TESTS": "1"
  },
  "remoteEnv": {
    "UV_LINK_MODE": "copy",
    "UV_PROJECT_ENVIRONMENT": ".venv-container",
    "SIDAR_PYTHON_VERSION": "3.11"
  },
  "postCreateCommand": "bash .devcontainer/setup-codespaces.sh post-create",
  "postStartCommand": "bash .devcontainer/setup-codespaces.sh post-start",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv-container/bin/python",
        "python.terminal.activateEnvironment": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker"
      ]
    }
  },
  "forwardPorts": [
    8000,
    11434
  ],
  "portsAttributes": {
    "8000": {
      "label": "Sidar web/API"
    },
    "11434": {
      "label": "Ollama API",
      "onAutoForward": "silent"
    }
  },
  "waitFor": "postCreateCommand",
  "updateContentCommand": "bash .devcontainer/setup-codespaces.sh sync",
  "initializeCommand": "bash .devcontainer/host-preflight.sh"
}