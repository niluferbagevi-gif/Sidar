# syntax=docker/dockerfile:1.7

# Sidar production image.
# Build:
#   docker build -f Dockerfile.production -t sidar:production .
#
# Builder-only compilers and uv never enter the final runtime stage.

ARG PYTHON_VERSION=3.11.15
ARG BASE_IMAGE=python:3.11.15-slim-bookworm@sha256:d29f48a31a8b408ed19272ca1e7b10ebae13b240a27e862d3d4217c528e2e0c3
ARG NODE_IMAGE=node:20.20.2-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0

# Build the SPA from the lockfile inside the image build. Production images
# must not depend on a host-created dist tree (or inherit its ownership/mode).
FROM ${NODE_IMAGE} AS frontend-builder
WORKDIR /frontend
COPY web_ui_react/package.json web_ui_react/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY web_ui_react/ ./
RUN npm run build

FROM ${BASE_IMAGE} AS builder

ARG PYTHON_VERSION=3.11.15
ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_PYTHON=${PYTHON_VERSION} \
    UV_LINK_MODE=copy \
    VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:${PATH}"
WORKDIR /app

# DEBIAN_FRONTEND: BASE_IMAGE bir Ubuntu tabanlı image ile override edilirse
# (örn. nvidia/cuda) tzdata gibi paketlerin interaktif kurulumda takılmasını
# engeller. Yalnızca bu RUN katmanına sınırlı; final imaja sızmaz.
RUN set -eux; \
    export DEBIAN_FRONTEND=noninteractive; \
    apt-get update; \
    apt-get install -y --no-install-recommends build-essential git; \
    rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.12.0@sha256:606e70c71c852d03f611b1e56a195d08648507018a7057fab82c4974c4eae105 /uv /uvx /bin/
RUN uv --version
COPY pyproject.toml uv.lock README.md ./
RUN test -f uv.lock || (echo "uv.lock is required for deterministic production builds" >&2; exit 1)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --extra production --no-dev --no-install-project
COPY . .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --extra production --no-dev

FROM ${BASE_IMAGE} AS runtime

ARG PYTHON_VERSION=3.11.15
LABEL maintainer="Sidar AI Project"
LABEL description="Sidar production Web/API image"
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=7860 \
    VIRTUAL_ENV=/app/.venv \
    PYTHONPATH=/app \
    SIDAR_ENV=production \
    ENABLE_TRACING=false \
    REDIS_URL=redis://redis:6379/0 \
    PATH="/app/.venv/bin:${PATH}"
WORKDIR /app

# Runtime installs only OS libraries/binaries used while serving requests.
# Compiler, build-essential, git and uv installation remain confined to builder.
# DEBIAN_FRONTEND scoped to this RUN only — see builder stage note above.
RUN set -eux; \
    export DEBIAN_FRONTEND=noninteractive; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl ffmpeg; \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /app /app
# Overwrite any source-tree path with the deterministic frontend artifact.
# Explicit modes ensure the unprivileged runtime user can traverse and read
# every asset regardless of the build host's umask or checkout permissions.
COPY --from=frontend-builder /frontend/dist /app/web_ui_react/dist
RUN chmod 755 /app /app/web_ui_react /app/web_ui_react/dist \
    && find /app/web_ui_react/dist -type d -exec chmod 755 {} + \
    && find /app/web_ui_react/dist -type f -exec chmod 644 {} +
RUN useradd -m -u 10001 sidaruser \
    && mkdir -p /app/logs /app/data /app/temp /app/sessions /app/chroma_db \
    && chown -R sidaruser:sidaruser \
      /app/logs /app/data /app/temp /app/sessions /app/chroma_db

USER sidaruser
EXPOSE 7860
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD sh -c 'curl -fsS "http://localhost:${WEB_PORT:-7860}/status" > /dev/null || exit 1'
ENTRYPOINT ["/app/.venv/bin/python", "-m", "uvicorn", "web_server:app"]
CMD ["--host", "0.0.0.0", "--port", "7860"]
