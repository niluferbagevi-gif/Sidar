# ─────────────────────────────────────────────
# Sidar — Production ortamı şablonu
#
# Kullanım:
#   cp .env.example .env
#   cp .env.production.example .env.production
#   SIDAR_ENV=production uv run python main.py
#
# Notlar:
# - Bu dosya örnektir; gerçek sırları yalnızca .env.production içinde saklayın.
# - Production'da DEBUG kapalı olmalı ve log seviyesi INFO/WARNING olmalıdır.
# - Runtime migrasyon atlamalarını önlemek için SIDAR_AUTO_MIGRATE=true önerilir.
# - SIDAR_AUTO_MIGRATE=false kurumsal değişiklik pencerelerinde kullanılabilir; bu durumda
#   uygulama runtime Alembic upgrade çalıştırmaz ve operatörün deploy öncesinde
#   `uv run alembic upgrade head` doğrulamasını tamamlaması gerekir.
# ─────────────────────────────────────────────

SIDAR_ENV=production
DEBUG=false
LOG_LEVEL=INFO
SIDAR_AUTO_MIGRATE=true

# Production Compose; named volume'lar restart/deploy sırasında veriyi korur.
COMPOSE_FILE=docker-compose.yml:docker-compose.production.yml
# Compose servislerine de production profilini enjekte eder; yalnızca CLI
# interpolation için --env-file vermek container env_file kontratını değiştirmez.
SIDAR_RUNTIME_ENV_FILE=.env.production
SIDAR_DATA_MOUNT=sidar_data_prod
SIDAR_LOGS_MOUNT=sidar_logs_prod
SIDAR_TEMP_MOUNT=sidar_temp_prod

AI_PROVIDER=ollama
CODING_MODEL=qwen2.5-coder:7b
OLLAMA_URL=http://localhost:11434/api
OLLAMA_TIMEOUT=600
OLLAMA_NUM_PARALLEL=4
# Long prompt assertion fix: 8192 ctx ile llama.cpp n_batch=512 varsayılanına düşmemek için 2048.
# Blank (varsayılan) = otomatik: config.py, GPU VRAM'e göre ayarlar ve
# kurulum betiği smoke testinde AYNI değeri kullanır (bkz. .env.example).
OLLAMA_NUM_BATCH=
OLLAMA_NUM_CTX=

# CPU-only production deploy için USE_GPU=false kalabilir; GPU image/host doğrulandığında true yapın.
# FP16 production varsayılanıdır: GPU aktif olduğunda VRAM tepe değerini düşürür.
USE_GPU=false
REQUIRE_GPU=false
GPU_MIXED_PRECISION=true

# PostgreSQL kimlik bilgileri .env dosyasından senkronize edilir.
POSTGRES_HOST=127.0.0.1
POSTGRES_CONTAINER_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sidar
POSTGRES_USER=sidar
POSTGRES_PASSWORD=replace-with-a-strong-24-plus-character-password

# Redis kimlik bilgisi de .env dosyasından senkronize edilir (docker-compose
# ile zorunlu; Redis host ağına asla publish edilmez).
REDIS_PASSWORD=replace-with-a-strong-24-plus-character-password

DB_DEGRADED_MODE_ON_POSTGRES_FAILURE=false
RAG_REQUIRED_FOR_READINESS=true

# Üretimde zorunlu güvenlik anahtarları (örnek placeholder).
API_KEY=replace-with-a-strong-production-api-key
JWT_SECRET_KEY=replace-with-a-strong-production-jwt-secret-32-plus-chars
MEMORY_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
ACCESS_LEVEL=sandbox
PROMPT_GUARD_ENABLED=true
GUARDRAILS_REQUIRED=true

# Production kod yürütme sandbox'ı açık kalacaksa Docker erişimi health/ready kapılarında doğrulanmalıdır.
SIDAR_CODE_EXECUTION_BACKEND=docker
CODE_EXECUTION_BACKEND=docker
DOCKER_AUTODETECT=true
