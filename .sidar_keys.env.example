# ~/.sidar_keys.env
# Sidar servis anahtarları ve entegrasyon sırları için kişisel dosya şablonu.
#
# Kullanım:
#   cp .sidar_keys.env.example ~/.sidar_keys.env
#   chmod 600 ~/.sidar_keys.env
#   # Sidar artık ~/.sidar_keys.env dosyasını config.py içinde otomatik yükler.
#
# Güvenlik:
# - Gerçek anahtarları repoya commit etmeyin.
# - Paylaşılmış/sızmış anahtarları sağlayıcı panellerinden hemen iptal edip yenileyin.
# - Kullanmadığınız servisleri boş bırakabilir veya satırı silebilirsiniz.
# - `uv run sidar generate-keys` varsayılan olarak .env dosyasını hedefler.
#   Bu kişisel dosyayı doldurmak için hedefi açıkça verin:
#     uv run sidar generate-keys --env ~/.sidar_keys.env --example .sidar_keys.env.example
#
# Doldurma rehberi:
# 1) OTOMATİK ÜRETİLEBİLİR / Sidar-managed secret:
#    Aşağıdaki değerleri elle uydurmayın; `generate-keys` güçlü rastgele değer üretir.
#    Komut boş veya zayıf değerleri doldurur, güçlü mevcut değerleri korur.
#    - POSTGRES_PASSWORD
#    - SIDAR_API_KEY
#    - SIDAR_JWT_SECRET_KEY
#    - SIDAR_MEMORY_ENCRYPTION_KEY
#    - AUTONOMY_WEBHOOK_SECRET
#    - SWARM_FEDERATION_SHARED_SECRET
#    - GITHUB_WEBHOOK_SECRET
#    - GRAFANA_ADMIN_PASSWORD
#    - SIDAR_METRICS_TOKEN
# 2) MANUEL DOLDURULACAK / Harici servis kimlik bilgisi:
#    Sağlayıcı panelinden aldığınız gerçek token/URL/ID değerlerini siz girmelisiniz.
#    OpenAI/Gemini/Anthropic/LiteLLM/HuggingFace, GitHub, Tavily/Google Search,
#    Slack, Jira, Teams, Meta, AWS, uzak Redis/RabbitMQ/Kafka ve kurum proxy/domain
#    ayarları otomatik üretilemez.
# 3) VARSAYILAN BIRAKILABİLİR / Operasyonel ayar:
#    Model adı, timeout, limit, feature flag, sandbox ve yerel URL değerlerini özel
#    ihtiyacınız yoksa değiştirmeyin.
#
# Satır etiketleri:
# - [OTOMATİK] `generate-keys` ile doldurulabilir Sidar secret'ı.
# - [MANUEL] Harici servisten alınan gerçek değer gerekir.
# - [VARSAYILAN] Özel ihtiyacınız yoksa mevcut değeri bırakın.

# ─────────────────────────────────────────────
# Sidar temel güvenlik sırları
# ─────────────────────────────────────────────
# [OTOMATİK] Aşağıdaki Sidar-managed secret'ları komutla üretin:
#   uv run sidar generate-keys --env ~/.sidar_keys.env --example .sidar_keys.env.example
SIDAR_API_KEY=
SIDAR_JWT_SECRET_KEY=
SIDAR_MEMORY_ENCRYPTION_KEY=
AUTONOMY_WEBHOOK_SECRET=
SWARM_FEDERATION_SHARED_SECRET=
GITHUB_WEBHOOK_SECRET=
SIDAR_METRICS_TOKEN=

# ─────────────────────────────────────────────
# AI sağlayıcıları
# ─────────────────────────────────────────────
# [VARSAYILAN] Yerel Ollama kullanıyorsanız bu üç satırı değiştirmeyin.
AI_PROVIDER=ollama
CODING_MODEL=qwen2.5-coder:7b
TEXT_MODEL=llama3.1:8b

# [MANUEL] Bulut sağlayıcı kullanacaksanız ilgili API key'i sağlayıcı panelinden alıp girin.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_TIMEOUT=60

# [MANUEL] LiteLLM proxy veya OpenRouter kullanıyorsanız URL/API key'i siz doldurun.
# [VARSAYILAN] Kullanmıyorsanız bu bloğu boş/default bırakın.
LITELLM_GATEWAY_URL=http://localhost:4000
LITELLM_API_KEY=
LITELLM_MODEL=gpt-4o-mini
LITELLM_FALLBACK_MODELS=claude-3-haiku-20240307,gemini-2.5-flash
LITELLM_TIMEOUT=60

# [MANUEL] Hugging Face modelleri/embedding indirme erişimi için opsiyonel gerçek token.
HF_TOKEN=
HF_HUB_OFFLINE=false

# ─────────────────────────────────────────────
# Ollama / yerel LLM
# ─────────────────────────────────────────────
# [VARSAYILAN] Yerel Ollama kullanıyorsanız bu değerleri değiştirmeyin.
OLLAMA_URL=http://localhost:11434/api
OLLAMA_TIMEOUT=600
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONTEXT_MAX_CHARS=12000
OLLAMA_STREAM_MAX_BUFFER_CHARS=1000000

# ─────────────────────────────────────────────
# GitHub ve web arama
# ─────────────────────────────────────────────
# [MANUEL] Repo erişimi ve web arama API'leri için gerçek token/ID değerlerini siz girin.
GITHUB_TOKEN=
# Alternatif GitHub token adları bazı araçlarda desteklenir.
GH_TOKEN=
GITHUB_PAT=
GITHUB_REPO=

SEARCH_ENGINE=auto
TAVILY_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
WEB_SEARCH_MAX_RESULTS=5
WEB_FETCH_TIMEOUT=15
WEB_SCRAPE_MAX_CHARS=12000

# ─────────────────────────────────────────────
# Slack
# ─────────────────────────────────────────────
# [MANUEL] Slack uygulamanızdan alınan token/webhook/channel değerleri.
SLACK_TOKEN=
SLACK_APP_LEVEL_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_DEFAULT_CHANNEL=

# ─────────────────────────────────────────────
# Jira / Atlassian
# ─────────────────────────────────────────────
# [MANUEL] Atlassian/Jira site URL, e-posta, API token ve proje anahtarını siz girin.
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_DEFAULT_PROJECT=
JIRA_DEFAULT_LABEL=sidar-ai
# Geriye dönük/alternatif adlandırma uyumluluğu gerekirse:
JIRA_BASE_URL=
JIRA_API_TOKEN=

# ─────────────────────────────────────────────
# Microsoft Teams
# ─────────────────────────────────────────────
# [MANUEL] Teams incoming webhook URL'si.
TEAMS_WEBHOOK_URL=

# ─────────────────────────────────────────────
# Meta Graph API / Poyraz sosyal yayınlama
# ─────────────────────────────────────────────
# [MANUEL] Meta Business/Graph API token ve hesap/sayfa/telefon ID değerleri.
META_GRAPH_API_TOKEN=
META_GRAPH_API_VERSION=v20.0
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
WHATSAPP_PHONE_NUMBER_ID=

# ─────────────────────────────────────────────
# AWS CLI tabanlı marketplace ajanı
# ─────────────────────────────────────────────
# [MANUEL] AWS IAM/SSO/CLI kimlik bilgileri; kullanmıyorsanız boş bırakın.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=
AWS_PROFILE=

# ─────────────────────────────────────────────
# Veritabanı, Redis ve event bus
# ─────────────────────────────────────────────
# [OTOMATİK] POSTGRES_PASSWORD güçlü parola olarak generate-keys ile üretilebilir.
# [MANUEL] Uzak/kurumsal DB, Redis, RabbitMQ veya Kafka kullanıyorsanız host/URL değerlerini siz girin.
# [VARSAYILAN] Lokal geliştirmede localhost/default değerleri yeterlidir.
# Not: Sidar DATABASE_URL ve container içi DSN değerlerini POSTGRES_* köklerinden türetir.
# Bu dosyada DATABASE_URL/SIDAR_CONTAINER_DATABASE_URL tutmayın; drift ve secret kopyası oluşur.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sidar
POSTGRES_USER=sidar
POSTGRES_PASSWORD=
DB_POOL_SIZE=
DB_DEGRADED_MODE_ON_POSTGRES_FAILURE=true
DB_DEGRADED_SQLITE_URL=
DB_SCHEMA_VERSION_TABLE=schema_versions

SIDAR_REDIS_URL=redis://localhost:6379/0
SIDAR_REDIS_MAX_CONNECTIONS=50
SIDAR_REDIS_CONNECT_TIMEOUT=0.5
SIDAR_REDIS_SOCKET_TIMEOUT=0.5

SIDAR_EVENT_BUS_BACKEND=redis
SIDAR_EVENT_BUS_CHANNEL=sidar:agent_events
SIDAR_EVENT_BUS_GROUP=sidar:agent_events:cg
SIDAR_EVENT_BUS_DLQ_CHANNEL=sidar:agent_events:dlq
SIDAR_EVENT_BUS_DLQ_MAXLEN=1000
SIDAR_EVENT_BUS_DLQ_PERSIST_PATH=
SIDAR_RABBITMQ_URL=amqp://guest:guest@localhost/
SIDAR_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SIDAR_EVENT_BUS_KAFKA_TOPIC=sidar.agent_events
SIDAR_EVENT_BUS_KAFKA_GROUP=sidar.agent_events.cg

# ─────────────────────────────────────────────
# RAG / embeddings
# ─────────────────────────────────────────────
# [VARSAYILAN] Lokal pgvector/RAG ayarları; özel embedding modeli kullanmıyorsanız değiştirmeyin.
RAG_VECTOR_BACKEND=pgvector
RAG_DIR=data/rag
RAG_TOP_K=3
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_FILE_THRESHOLD=20000
MAX_RAG_UPLOAD_BYTES=52428800
PGVECTOR_TABLE=rag_embeddings
PGVECTOR_EMBEDDING_DIM=384
PGVECTOR_EMBEDDING_MODEL=all-MiniLM-L6-v2
ENABLE_GRAPH_RAG=true
ENABLE_RAG_ENTITY_EXTRACTION=true

# ─────────────────────────────────────────────
# Web arayüzü, erişim ve metrikler
# ─────────────────────────────────────────────
# [VARSAYILAN] Lokal geliştirme için bırakın; production/domain/proxy değerlerini elle ayarlayın.
# [OTOMATİK] GRAFANA_ADMIN_PASSWORD ve SIDAR_METRICS_TOKEN generate-keys ile üretilebilir.
SIDAR_ENV=development
SIDAR_ACCESS_LEVEL=sandbox
SIDAR_WEB_HOST=127.0.0.1
SIDAR_WEB_PORT=7860
WEB_GPU_PORT=7861
TRUSTED_PROXIES=127.0.0.1
SIDAR_RATE_LIMIT_WINDOW=60
SIDAR_RATE_LIMIT_CHAT=20
SIDAR_RATE_LIMIT_MUTATIONS=60
SIDAR_RATE_LIMIT_GET_IO=30
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_PASSWORD=

# ─────────────────────────────────────────────
# Multimodal / vision / voice
# ─────────────────────────────────────────────
# [VARSAYILAN] Donanım/model tercihinize göre gerekirse değiştirin.
ENABLE_VISION=true
VISION_MAX_IMAGE_BYTES=10485760
VISION_MODEL=llama3.2-vision:11b-instruct-q4_K_M
ENABLE_MULTIMODAL=true
MULTIMODAL_MAX_FILE_BYTES=52428800
VOICE_STT_PROVIDER=whisper
WHISPER_MODEL=turbo
VOICE_TTS_PROVIDER=auto
VOICE_TTS_VOICE=
VOICE_TTS_SEGMENT_CHARS=48
VOICE_TTS_BUFFER_CHARS=96
VOICE_VAD_ENABLED=true
VOICE_VAD_MIN_SPEECH_BYTES=1024
VOICE_DUPLEX_ENABLED=true
VOICE_VAD_INTERRUPT_MIN_BYTES=384
VOICE_WS_MAX_BYTES=10485760

# ─────────────────────────────────────────────
# Browser automation / LSP
# ─────────────────────────────────────────────
# [VARSAYILAN] Lokal araç komutları; özel LSP/browser kurulumunuz yoksa bırakın.
BROWSER_PROVIDER=auto
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=15000
BROWSER_ALLOWED_DOMAINS=
BROWSER_VISUAL_QA_ENABLED=true
BROWSER_VISUAL_QA_DRIFT_THRESHOLD=0.015
BROWSER_VISUAL_QA_MULTIMODAL_MARGIN=0.005
ENABLE_LSP=true
LSP_TIMEOUT_SECONDS=15
LSP_MAX_REFERENCES=200
PYTHON_LSP_SERVER=pyright-langserver
TYPESCRIPT_LSP_SERVER=typescript-language-server

# ─────────────────────────────────────────────
# Güvenli kod çalıştırma sandbox'ı
# ─────────────────────────────────────────────
# [VARSAYILAN] Docker sandbox ayarları; production güvenlik politikanıza göre elle sıkılaştırın.
SIDAR_DOCKER_PYTHON_IMAGE=python:3.11-slim
SIDAR_DOCKER_TEST_IMAGE=sidar:latest
SIDAR_DOCKER_RUNTIME=
SIDAR_DOCKER_ALLOWED_RUNTIMES=runc,runsc,kata-runtime
SIDAR_DOCKER_MICROVM_MODE=off
SIDAR_DOCKER_MEM_LIMIT=256m
SIDAR_DOCKER_NETWORK_DISABLED=true
SIDAR_DOCKER_NANO_CPUS=1000000000
SIDAR_DOCKER_EXEC_TIMEOUT=30
SIDAR_DOCKER_REQUIRED=false
SANDBOX_NETWORK=bridge

# ─────────────────────────────────────────────
# Güvenlik, DLP, HITL ve kalite kapıları
# ─────────────────────────────────────────────
# [VARSAYILAN] Güvenlik bayrakları; production için HITL/self-heal politikasını bilinçli seçin.
DLP_ENABLED=true
DLP_LOG_DETECTIONS=false
HITL_ENABLED=false
HITL_TIMEOUT_SECONDS=120
ENABLE_EVENT_WEBHOOKS=true
ENABLE_SWARM_FEDERATION=true
SIDAR_ENABLE_AUTONOMOUS_SELF_HEAL=false
SIDAR_SELF_HEAL_MAX_PATCHES=3
SIDAR_SELF_HEAL_PLAN_MAX_RETRIES=3
SIDAR_SELF_HEAL_PLAN_TIMEOUT_SECONDS=180
SIDAR_SELF_HEAL_SKIP_FULL_SCOPE_MIN_FILES=6
REVIEWER_TEST_COMMAND=uv run pytest

# ─────────────────────────────────────────────
# Gözlemlenebilirlik ve maliyet yönlendirme
# ─────────────────────────────────────────────
# [VARSAYILAN] Tracing/cost routing kapalı gelir; harici endpoint/model varsa elle girin.
ENABLE_TRACING=false
OTEL_EXPORTER_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=sidar
OTEL_INSTRUMENT_FASTAPI=true
OTEL_INSTRUMENT_HTTPX=true
ENABLE_SEMANTIC_CACHE=false
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_TTL=3600
SEMANTIC_CACHE_MAX_ITEMS=500
ENABLE_COST_ROUTING=false
COST_ROUTING_COMPLEXITY_THRESHOLD=0.55
COST_ROUTING_LOCAL_PROVIDER=ollama
COST_ROUTING_LOCAL_MODEL=
COST_ROUTING_CLOUD_PROVIDER=
COST_ROUTING_CLOUD_MODEL=
COST_ROUTING_DAILY_BUDGET_USD=1.0
COST_ROUTING_TOKEN_THRESHOLD=0

# ─────────────────────────────────────────────
# Active learning / LoRA / judge
# ─────────────────────────────────────────────
# [VARSAYILAN] Judge/LoRA/continuous learning ayarları; eğitim/model yolunu siz belirlersiniz.
SIDAR_JUDGE_ENABLED=false
SIDAR_JUDGE_MODEL=
SIDAR_JUDGE_PROVIDER=ollama
SIDAR_JUDGE_SAMPLE_RATE=0.2
SIDAR_JUDGE_AUTO_FEEDBACK_ENABLED=true
SIDAR_JUDGE_AUTO_FEEDBACK_THRESHOLD=8.0
SIDAR_JUDGE_RESPONSE_MODEL=
ENABLE_ACTIVE_LEARNING=true
AL_MIN_RATING_FOR_TRAIN=1
ENABLE_LORA_TRAINING=false
LORA_BASE_MODEL=
LORA_RANK=8
LORA_ALPHA=16
LORA_DROPOUT=0.05
LORA_EPOCHS=3
LORA_BATCH_SIZE=4
LORA_USE_4BIT=true
LORA_OUTPUT_DIR=data/lora_adapters
ENABLE_CONTINUOUS_LEARNING=false
CONTINUOUS_LEARNING_MIN_SFT_EXAMPLES=20
CONTINUOUS_LEARNING_MIN_PREFERENCE_EXAMPLES=10
CONTINUOUS_LEARNING_MAX_PENDING_SIGNALS=5000
CONTINUOUS_LEARNING_COOLDOWN_SECONDS=3600
CONTINUOUS_LEARNING_OUTPUT_DIR=data/continuous_learning
CONTINUOUS_LEARNING_SFT_FORMAT=alpaca

# ─────────────────────────────────────────────
# Donanım / GPU
# ─────────────────────────────────────────────
# [VARSAYILAN] Makinenizin GPU durumuna göre elle değiştirin.
USE_GPU=true
REQUIRE_GPU=false
GPU_DEVICE=0
MULTI_GPU=false
GPU_MEMORY_FRACTION=0.8
LLM_GPU_MEMORY_FRACTION=0.8
RAG_GPU_MEMORY_FRACTION=0.28
GPU_MIXED_PRECISION=false
