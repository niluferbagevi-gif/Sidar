# ~/.sidar_keys.env
# Sidar servis anahtarları ve entegrasyon sırları için kişisel dosya şablonu.
#
# Kullanım:
#   cp .sidar_keys.env.example ~/.sidar_keys.env
#   chmod 600 ~/.sidar_keys.env
#   # Sidar artık ~/.sidar_keys.env dosyasını config.py içinde otomatik yükler.
#
# Güvenlik:
# - Gerçek anahtarları repoya commit etmeyin.
# - Paylaşılmış/sızmış anahtarları sağlayıcı panellerinden hemen iptal edip yenileyin.
# - Kullanmadığınız servisleri boş bırakabilir veya satırı silebilirsiniz.
# - Temel local sırlar için `uv run sidar generate-keys` veya `uv run sidar init` kullanın.

# ─────────────────────────────────────────────
# Sidar temel güvenlik sırları
# ─────────────────────────────────────────────
SIDAR_API_KEY=
SIDAR_JWT_SECRET_KEY=
SIDAR_MEMORY_ENCRYPTION_KEY=
AUTONOMY_WEBHOOK_SECRET=
SWARM_FEDERATION_SHARED_SECRET=
GITHUB_WEBHOOK_SECRET=
SIDAR_METRICS_TOKEN=

# ─────────────────────────────────────────────
# AI sağlayıcıları
# ─────────────────────────────────────────────
AI_PROVIDER=ollama
CODING_MODEL=qwen2.5-coder:7b
TEXT_MODEL=llama3.1:8b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_TIMEOUT=60

# LiteLLM proxy veya OpenRouter kullanıyorsanız doldurun.
LITELLM_GATEWAY_URL=http://localhost:4000
LITELLM_API_KEY=
LITELLM_MODEL=gpt-4o-mini
LITELLM_FALLBACK_MODELS=claude-3-haiku-20240307,gemini-2.5-flash
LITELLM_TIMEOUT=60

# Hugging Face modelleri/embedding indirme erişimi için opsiyonel.
HF_TOKEN=
HF_HUB_OFFLINE=false

# ─────────────────────────────────────────────
# Ollama / yerel LLM
# ─────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434/api
OLLAMA_TIMEOUT=600
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONTEXT_MAX_CHARS=12000
OLLAMA_STREAM_MAX_BUFFER_CHARS=1000000

# ─────────────────────────────────────────────
# GitHub ve web arama
# ─────────────────────────────────────────────
GITHUB_TOKEN=
# Alternatif GitHub token adları bazı araçlarda desteklenir.
GH_TOKEN=
GITHUB_PAT=
GITHUB_REPO=

SEARCH_ENGINE=auto
TAVILY_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
WEB_SEARCH_MAX_RESULTS=5
WEB_FETCH_TIMEOUT=15
WEB_FETCH_MAX_CHARS=12000
WEB_SCRAPE_MAX_CHARS=12000

# ─────────────────────────────────────────────
# Slack
# ─────────────────────────────────────────────
SLACK_TOKEN=
SLACK_APP_LEVEL_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_DEFAULT_CHANNEL=

# ─────────────────────────────────────────────
# Jira / Atlassian
# ─────────────────────────────────────────────
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_DEFAULT_PROJECT=
JIRA_DEFAULT_LABEL=sidar-ai
# Geriye dönük/alternatif adlandırma uyumluluğu gerekirse:
JIRA_BASE_URL=
JIRA_API_TOKEN=

# ─────────────────────────────────────────────
# Microsoft Teams
# ─────────────────────────────────────────────
TEAMS_WEBHOOK_URL=

# ─────────────────────────────────────────────
# Meta Graph API / Poyraz sosyal yayınlama
# ─────────────────────────────────────────────
META_GRAPH_API_TOKEN=
META_GRAPH_API_VERSION=v20.0
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
WHATSAPP_PHONE_NUMBER_ID=

# ─────────────────────────────────────────────
# AWS CLI tabanlı marketplace ajanı
# ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=
AWS_PROFILE=

# ─────────────────────────────────────────────
# Veritabanı, Redis ve event bus
# ─────────────────────────────────────────────
# Not: Sidar normalde DATABASE_URL'i POSTGRES_* köklerinden türetir.
# Sadece bilinçli override gerekiyorsa DATABASE_URL kullanın.
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sidar
POSTGRES_USER=sidar
POSTGRES_PASSWORD=
DB_POOL_SIZE=
DB_DEGRADED_MODE_ON_POSTGRES_FAILURE=true
DB_DEGRADED_SQLITE_URL=
DB_SCHEMA_VERSION_TABLE=schema_versions

REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_CONNECT_TIMEOUT=0.5
REDIS_SOCKET_TIMEOUT=0.5

SIDAR_EVENT_BUS_BACKEND=redis
SIDAR_EVENT_BUS_CHANNEL=sidar:agent_events
SIDAR_EVENT_BUS_GROUP=sidar:agent_events:cg
SIDAR_EVENT_BUS_DLQ_CHANNEL=sidar:agent_events:dlq
SIDAR_EVENT_BUS_DLQ_MAXLEN=1000
SIDAR_EVENT_BUS_DLQ_PERSIST_PATH=
RABBITMQ_URL=amqp://guest:guest@localhost/
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SIDAR_EVENT_BUS_KAFKA_TOPIC=sidar.agent_events
SIDAR_EVENT_BUS_KAFKA_GROUP=sidar.agent_events.cg

# ─────────────────────────────────────────────
# RAG / embeddings
# ─────────────────────────────────────────────
RAG_VECTOR_BACKEND=pgvector
RAG_DIR=data/rag
RAG_TOP_K=3
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_FILE_THRESHOLD=20000
MAX_RAG_UPLOAD_BYTES=52428800
PGVECTOR_TABLE=rag_embeddings
PGVECTOR_EMBEDDING_DIM=384
PGVECTOR_EMBEDDING_MODEL=all-MiniLM-L6-v2
ENABLE_GRAPH_RAG=true
ENABLE_RAG_ENTITY_EXTRACTION=true

# ─────────────────────────────────────────────
# Web arayüzü, erişim ve metrikler
# ─────────────────────────────────────────────
SIDAR_ENV=development
SIDAR_ACCESS_LEVEL=sandbox
SIDAR_WEB_HOST=127.0.0.1
SIDAR_WEB_PORT=7860
WEB_GPU_PORT=7861
TRUSTED_PROXIES=127.0.0.1
SIDAR_RATE_LIMIT_WINDOW=60
SIDAR_RATE_LIMIT_CHAT=20
SIDAR_RATE_LIMIT_MUTATIONS=60
SIDAR_RATE_LIMIT_GET_IO=30
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_PASSWORD=

# ─────────────────────────────────────────────
# Multimodal / vision / voice
# ─────────────────────────────────────────────
ENABLE_VISION=true
VISION_MAX_IMAGE_BYTES=10485760
VISION_MODEL=llama3.2-vision:11b-instruct-q4_K_M
ENABLE_MULTIMODAL=true
MULTIMODAL_MAX_FILE_BYTES=52428800
VOICE_STT_PROVIDER=whisper
WHISPER_MODEL=turbo
VOICE_TTS_PROVIDER=auto
VOICE_TTS_VOICE=
VOICE_TTS_SEGMENT_CHARS=48
VOICE_TTS_BUFFER_CHARS=96
VOICE_VAD_ENABLED=true
VOICE_VAD_MIN_SPEECH_BYTES=1024
VOICE_DUPLEX_ENABLED=true
VOICE_VAD_INTERRUPT_MIN_BYTES=384
VOICE_WS_MAX_BYTES=10485760

# ─────────────────────────────────────────────
# Browser automation / LSP
# ─────────────────────────────────────────────
BROWSER_PROVIDER=auto
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=15000
BROWSER_ALLOWED_DOMAINS=
BROWSER_VISUAL_QA_ENABLED=true
BROWSER_VISUAL_QA_DRIFT_THRESHOLD=0.015
BROWSER_VISUAL_QA_MULTIMODAL_MARGIN=0.005
ENABLE_LSP=true
LSP_TIMEOUT_SECONDS=15
LSP_MAX_REFERENCES=200
PYTHON_LSP_SERVER=pyright-langserver
TYPESCRIPT_LSP_SERVER=typescript-language-server

# ─────────────────────────────────────────────
# Güvenli kod çalıştırma sandbox'ı
# ─────────────────────────────────────────────
DOCKER_PYTHON_IMAGE=python:3.11-slim
DOCKER_TEST_IMAGE=sidar:latest
DOCKER_RUNTIME=
DOCKER_ALLOWED_RUNTIMES=,runc,runsc,kata-runtime
DOCKER_MICROVM_MODE=off
DOCKER_MEM_LIMIT=256m
DOCKER_NETWORK_DISABLED=true
DOCKER_NANO_CPUS=1000000000
DOCKER_EXEC_TIMEOUT=30
DOCKER_REQUIRED=false
SANDBOX_NETWORK=bridge

# ─────────────────────────────────────────────
# Güvenlik, DLP, HITL ve kalite kapıları
# ─────────────────────────────────────────────
DLP_ENABLED=true
DLP_LOG_DETECTIONS=false
HITL_ENABLED=false
HITL_TIMEOUT_SECONDS=120
ENABLE_EVENT_WEBHOOKS=true
ENABLE_SWARM_FEDERATION=true
ENABLE_AUTONOMOUS_SELF_HEAL=false
SELF_HEAL_MAX_PATCHES=3
SELF_HEAL_PLAN_MAX_RETRIES=3
SELF_HEAL_PLAN_TIMEOUT_SECONDS=180
SELF_HEAL_SKIP_FULL_SCOPE_MIN_FILES=6
REVIEWER_TEST_COMMAND=uv run pytest

# ─────────────────────────────────────────────
# Gözlemlenebilirlik ve maliyet yönlendirme
# ─────────────────────────────────────────────
ENABLE_TRACING=false
OTEL_EXPORTER_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=sidar
OTEL_INSTRUMENT_FASTAPI=true
OTEL_INSTRUMENT_HTTPX=true
ENABLE_SEMANTIC_CACHE=false
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_TTL=3600
SEMANTIC_CACHE_MAX_ITEMS=500
ENABLE_COST_ROUTING=false
COST_ROUTING_COMPLEXITY_THRESHOLD=0.55
COST_ROUTING_LOCAL_PROVIDER=ollama
COST_ROUTING_LOCAL_MODEL=
COST_ROUTING_CLOUD_PROVIDER=
COST_ROUTING_CLOUD_MODEL=
COST_ROUTING_DAILY_BUDGET_USD=1.0
COST_ROUTING_TOKEN_THRESHOLD=0

# ─────────────────────────────────────────────
# Active learning / LoRA / judge
# ─────────────────────────────────────────────
JUDGE_ENABLED=false
JUDGE_MODEL=
JUDGE_PROVIDER=ollama
JUDGE_SAMPLE_RATE=0.2
JUDGE_AUTO_FEEDBACK_ENABLED=true
JUDGE_AUTO_FEEDBACK_THRESHOLD=8.0
JUDGE_RESPONSE_MODEL=
ENABLE_ACTIVE_LEARNING=true
AL_MIN_RATING_FOR_TRAIN=1
ENABLE_LORA_TRAINING=false
LORA_BASE_MODEL=
LORA_RANK=8
LORA_ALPHA=16
LORA_DROPOUT=0.05
LORA_EPOCHS=3
LORA_BATCH_SIZE=4
LORA_USE_4BIT=true
LORA_OUTPUT_DIR=data/lora_adapters
ENABLE_CONTINUOUS_LEARNING=false
CONTINUOUS_LEARNING_MIN_SFT_EXAMPLES=20
CONTINUOUS_LEARNING_MIN_PREFERENCE_EXAMPLES=10
CONTINUOUS_LEARNING_MAX_PENDING_SIGNALS=5000
CONTINUOUS_LEARNING_COOLDOWN_SECONDS=3600
CONTINUOUS_LEARNING_OUTPUT_DIR=data/continuous_learning
CONTINUOUS_LEARNING_SFT_FORMAT=alpaca

# ─────────────────────────────────────────────
# Donanım / GPU
# ─────────────────────────────────────────────
USE_GPU=true
REQUIRE_GPU=false
GPU_DEVICE=0
MULTI_GPU=false
GPU_MEMORY_FRACTION=0.8
LLM_GPU_MEMORY_FRACTION=0.8
RAG_GPU_MEMORY_FRACTION=0.28
GPU_MIXED_PRECISION=false
