# ~/.sidar_keys.env — Sidar kişisel gizli anahtar dosyası şablonu
#
# Kullanım:
#   1) Bu dosyayı repoya değil kullanıcı ev dizinine kopyalayın:
#        cp .sidar_keys.env.example ~/.sidar_keys.env
#   2) Yalnız kullandığınız servislerin MANUEL alanlarını yorumdan çıkarıp doldurun.
#   3) Dosya izinlerini kısıtlayın:
#        chmod 600 ~/.sidar_keys.env
#
# Yükleme sırası:
#   config.py önce .env, sonra .env.<SIDAR_ENV>, sonra DOTENV_FILE, en son
#   SIDAR_KEYS_FILE dosyasını yükler. Bu yüzden burada dolu olan değerler .env
#   değerlerini override eder.
#
# Güvenlik:
#   - Bu dosyaya gerçek secret yazılır; Git'e commit etmeyin.
#   - Paylaşılan / sızmış görünen tokenları sağlayıcı panellerinden iptal edip yenileyin.
#   - Kullanmadığınız servisleri yorum satırı olarak bırakın veya ilgili satırı silebilirsiniz;
#     boş KEY= satırı .env değerini override edebilir.
#   - install_sidar.sh bazı yerel secretları .env içinde otomatik üretir. Bu otomatik
#     alanları burada doldurursanız .env'deki otomatik değerlerin üstüne yazarsınız.
#
# Etiketler:
#   [VARSAYILAN] Güvenli/uyumlu yerel varsayılan; genelde değiştirmeyin.
#   [MANUEL]     Sağlayıcı panelinden veya kendi ortamınızdan alıp sizin doldurmanız gerekir.
#   [OTOMATİK]   install_sidar.sh .env içine güvenli üretir; burada normalde boş bırakın.
#   [OPSİYONEL]  Sadece ilgili entegrasyonu kullanıyorsanız doldurun.

# ─── Dosya yükleme ve temel çalışma modu ───────────────────────
# [VARSAYILAN] Bu dosyanın konumu. .env içinden override etmek isterseniz aynı değeri kullanın.
SIDAR_KEYS_FILE=~/.sidar_keys.env

# [VARSAYILAN] Repo standardı: yerel Ollama + qwen2.5-coder:7b.
# Harici sağlayıcı kullanacaksanız AI_PROVIDER değerini openai, anthropic, gemini veya litellm yapın
# ve ilgili API anahtarını aşağıdaki MANUEL bölümde doldurun.
AI_PROVIDER=ollama
CODING_MODEL=qwen2.5-coder:7b
TEXT_MODEL=gemma2:9b
OLLAMA_URL=http://localhost:11434/api

# ─── Yerel güvenlik secretları ─────────────────────────────────
# [OTOMATİK] Normal kurulumda install_sidar.sh bu değerleri .env içine üretir.
# Bu dosyada yorum satırı olarak bırakmanız önerilir; böylece .env'deki otomatik
# ve senkron değerler kullanılır.
#
# [MANUEL] Installer kullanmadan sadece ~/.sidar_keys.env ile çalışacaksanız doldurun:
#   API_KEY / JWT_SECRET_KEY / POSTGRES_PASSWORD:
#     uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
#   MEMORY_ENCRYPTION_KEY (Fernet olmak zorunda):
#     uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# API_KEY=
# JWT_SECRET_KEY=
# MEMORY_ENCRYPTION_KEY=
# POSTGRES_PASSWORD=

# [OTOMATİK/OPSİYONEL] install_sidar.sh .env içinde güçlü değer üretir.
# Yalnız webhook/metrics/Grafana değerlerini merkezi secret dosyasından yönetmek istiyorsanız doldurun.
# GITHUB_WEBHOOK_SECRET=
# METRICS_TOKEN=
# GRAFANA_ADMIN_PASSWORD=

# [OPSİYONEL] Doğrudan DSN vermek istiyorsanız doldurun. Boşsa config.py POSTGRES_* parçalarından üretir.
# Parola drift'i yaşamamak için DATABASE_URL ve SIDAR_CONTAINER_DATABASE_URL değerlerindeki parola,
# POSTGRES_PASSWORD ile aynı olmalıdır.
# DATABASE_URL=
# SIDAR_CONTAINER_DATABASE_URL=

# ─── AI Sağlayıcıları ─────────────────────────────────────────
# [MANUEL/OPSİYONEL] Yalnız ilgili sağlayıcıyı kullanıyorsanız satırı yorumdan çıkarıp API anahtarını doldurun.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60

# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_TIMEOUT=60

# [MANUEL/OPSİYONEL] LiteLLM gateway / OpenRouter uyumlu proxy kullanıyorsanız doldurun.
# LITELLM_GATEWAY_URL=
# LITELLM_API_KEY=
# LITELLM_MODEL=
# LITELLM_FALLBACK_MODELS=
LITELLM_TIMEOUT=60

# [MANUEL/OPSİYONEL] HuggingFace özel/gated model erişimi için.
# HF_TOKEN=
HF_HUB_OFFLINE=false

# ─── GitHub ve Web Arama ──────────────────────────────────────
# [MANUEL/OPSİYONEL] GitHub erişimi veya API tabanlı web arama kullanıyorsanız doldurun.
# GITHUB_TOKEN=
# GITHUB_REPO=

SEARCH_ENGINE=auto
# TAVILY_API_KEY=
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX=

# ─── Meta / Sosyal Medya ───────────────────────────────────────
# [MANUEL/OPSİYONEL] PoyrazAgent sosyal yayın araçlarını kullanıyorsanız doldurun.
# META_GRAPH_API_TOKEN=
META_GRAPH_API_VERSION=v20.0
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# FACEBOOK_PAGE_ID=
# WHATSAPP_PHONE_NUMBER_ID=

# ─── Slack ────────────────────────────────────────────────────
# [MANUEL/OPSİYONEL]
# SLACK_TOKEN=
# SLACK_APP_LEVEL_TOKEN=
# SLACK_WEBHOOK_URL=
# SLACK_DEFAULT_CHANNEL=

# ─── Jira / Atlassian ─────────────────────────────────────────
# [MANUEL/OPSİYONEL]
# JIRA_BASE_URL ve JIRA_API_TOKEN alternatif adlardır; boş bırakılırsa
# config.py JIRA_URL ve JIRA_TOKEN değerlerini kullanır.
# JIRA_URL=
# JIRA_EMAIL=
# JIRA_TOKEN=
# JIRA_DEFAULT_PROJECT=
JIRA_DEFAULT_LABEL=sidar-ai
# JIRA_BASE_URL=
# JIRA_API_TOKEN=

# ─── Microsoft Teams ──────────────────────────────────────────
# [MANUEL/OPSİYONEL]
# TEAMS_WEBHOOK_URL=

# ─── Otonomi / webhook paylaşılmış secretları ─────────────────
# [MANUEL/OPSİYONEL] Harici webhook veya swarm federation açıyorsanız doldurun.
# AUTONOMY_WEBHOOK_SECRET=
# SWARM_FEDERATION_SHARED_SECRET=

# ─── Event bus / broker kimlikli URL'leri ─────────────────────
# [OPSİYONEL] Kimlik bilgisi içeren broker URL'lerini .env.advanced yerine burada
# tutacaksanız satırları yorumdan çıkarın.
# Prefixed adlar birincildir; legacy adlar uyumluluk için aynı değere ayarlanabilir.
# SIDAR_REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/0
# SIDAR_RABBITMQ_URL=amqp://guest:guest@localhost/
# RABBITMQ_URL=amqp://guest:guest@localhost/
# SIDAR_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
