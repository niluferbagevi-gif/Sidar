# ~/.sidar_keys.env — Sidar kişisel gizli anahtar dosyası şablonu
#
# Kullanım:
#   1) Bu dosyayı repoya değil kullanıcı ev dizinine kopyalayın:
#        cp .sidar_keys.env.example ~/.sidar_keys.env
#   2) SADECE kullanacağınız ve gerçek değerini bildiğiniz satırları açıp doldurun.
#      Boş `KEY=` satırlarını aktif bırakmayın; SIDAR_KEYS_FILE en son ve override=True
#      ile yüklendiği için boş değerler .env içindeki otomatik üretilmiş değerleri siler.
#   3) Dosya izinlerini kısıtlayın:
#        chmod 600 ~/.sidar_keys.env
#
# Güvenlik:
#   - Bu dosyaya gerçek secret yazılır; Git'e commit etmeyin.
#   - Paylaşılan / sızmış görünen tokenları sağlayıcı panellerinden iptal edip yenileyin.
#   - Kullanmadığınız servisleri yorum satırı olarak bırakın veya ilgili satırı silin.
#
# Yükleme sırası:
#   .env -> .env.advanced -> .env.${SIDAR_ENV} -> DOTENV_FILE -> SIDAR_KEYS_FILE
#   Bu dosya en son yüklendiğinden yalnız bilinçli override/secrets için kullanılmalıdır.

# ─── Genellikle .env içinde kalması gereken çalışma modu ────────────────────
# Aşağıdaki alanları yalnız bu kişisel secret dosyasından bilinçli override etmek
# istiyorsanız açın. Varsayılan yerel coding modeli qwen2.5-coder:7b'dir.
#SIDAR_KEYS_FILE=~/.sidar_keys.env
#AI_PROVIDER=ollama
#CODING_MODEL=qwen2.5-coder:7b
#TEXT_MODEL=gemma2:9b
#OLLAMA_URL=http://localhost:11434/api

# ─── OTONOM oluşabilen yerel güvenlik secretları ────────────────────────────
# install_sidar.sh bu alanları .env içinde otomatik ve güvenli üretir:
#   POSTGRES_PASSWORD, API_KEY, JWT_SECRET_KEY, MEMORY_ENCRYPTION_KEY,
#   AUTONOMY_WEBHOOK_SECRET, SWARM_FEDERATION_SHARED_SECRET,
#   GITHUB_WEBHOOK_SECRET, GRAFANA_ADMIN_PASSWORD, METRICS_TOKEN
#
# Bu dosyaya sadece şu iki durumda yazın:
#   - install_sidar.sh kullanmadan manuel kurulum yapıyorsunuz, veya
#   - .env yerine ev dizinindeki secret dosyasını tek kişisel secret kaynağı yapmak istiyorsunuz.
#
# Üretim yardımcı komutları:
#   API_KEY / POSTGRES_PASSWORD / JWT_SECRET_KEY:
#     uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
#   MEMORY_ENCRYPTION_KEY (Fernet):
#     uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   Hex webhook/federation secret:
#     uv run python -c "import secrets; print(secrets.token_hex(32))"
#
#API_KEY=<MANUEL_VEYA_OTONOM_URETILMIS_DEGERI_BURAYA_KOPYALA>
#JWT_SECRET_KEY=<MANUEL_VEYA_OTONOM_URETILMIS_DEGERI_BURAYA_KOPYALA>
#MEMORY_ENCRYPTION_KEY=<FERNET_KEY>
#POSTGRES_PASSWORD=<GUCLU_POSTGRES_PAROLASI>
#AUTONOMY_WEBHOOK_SECRET=<64_HEX_SECRET>
#SWARM_FEDERATION_SHARED_SECRET=<64_HEX_SECRET>
#GITHUB_WEBHOOK_SECRET=<40_VEYA_64_HEX_SECRET>
#GRAFANA_ADMIN_PASSWORD=<GUCLU_GRAFANA_PAROLASI>
#METRICS_TOKEN=<GUCLU_METRICS_TOKEN>

# Opsiyonel: doğrudan DSN vermek istiyorsanız açın; boşsa POSTGRES_* parçalarından üretilir.
#DATABASE_URL=postgresql+asyncpg://sidar:<POSTGRES_PASSWORD>@localhost:5432/sidar
#SIDAR_CONTAINER_DATABASE_URL=postgresql+asyncpg://sidar:<POSTGRES_PASSWORD>@postgres:5432/sidar
#SELF_HEAL_DATABASE_URL=

# ─── MANUEL doldurulan AI sağlayıcıları ─────────────────────────────────────
# AI_PROVIDER=openai ise OPENAI_API_KEY zorunludur.
#OPENAI_API_KEY=<OPENAI_API_KEY>
#OPENAI_MODEL=gpt-4o-mini
#OPENAI_TIMEOUT=60

# AI_PROVIDER=gemini ise GEMINI_API_KEY zorunludur.
#GEMINI_API_KEY=<GEMINI_API_KEY>
#GEMINI_MODEL=gemini-2.5-flash

# AI_PROVIDER=anthropic ise ANTHROPIC_API_KEY zorunludur.
#ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>
#ANTHROPIC_MODEL=claude-3-5-sonnet-latest
#ANTHROPIC_TIMEOUT=60

# AI_PROVIDER=litellm ise LITELLM_GATEWAY_URL, LITELLM_API_KEY ve LITELLM_MODEL zorunludur.
#LITELLM_GATEWAY_URL=https://<litellm-gateway-host>
#LITELLM_API_KEY=<LITELLM_API_KEY>
#LITELLM_MODEL=<PROVIDER/MODEL>
#LITELLM_FALLBACK_MODELS=
#LITELLM_TIMEOUT=60

# HuggingFace özel/gated model erişimi için.
#HF_TOKEN=<HF_TOKEN>
#HF_HUB_OFFLINE=false

# ─── MANUEL doldurulan GitHub ve Web Arama ─────────────────────────────────
#GITHUB_TOKEN=<GITHUB_TOKEN>
#GITHUB_REPO=owner/repo

# SEARCH_ENGINE=auto iken Tavily veya Google anahtarları varsa ilgili araçlar kullanılır.
#SEARCH_ENGINE=auto
#TAVILY_API_KEY=<TAVILY_API_KEY>
#GOOGLE_SEARCH_API_KEY=<GOOGLE_SEARCH_API_KEY>
#GOOGLE_SEARCH_CX=<GOOGLE_CUSTOM_SEARCH_CX>

# ─── MANUEL doldurulan Meta / Poyraz sosyal yayın anahtarları ───────────────
# PoyrazAgent Instagram/Facebook/WhatsApp yayın araçları bu değerleri config.py'dan okur.
#META_GRAPH_API_TOKEN=<META_GRAPH_API_TOKEN>
#META_GRAPH_API_VERSION=v20.0
#INSTAGRAM_BUSINESS_ACCOUNT_ID=<INSTAGRAM_BUSINESS_ACCOUNT_ID>
#FACEBOOK_PAGE_ID=<FACEBOOK_PAGE_ID>
#WHATSAPP_PHONE_NUMBER_ID=<WHATSAPP_PHONE_NUMBER_ID>

# ─── MANUEL doldurulan Slack ────────────────────────────────────────────────
#SLACK_TOKEN=xoxb-...
#SLACK_APP_LEVEL_TOKEN=xapp-...
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
#SLACK_DEFAULT_CHANNEL=#sidar-updates

# ─── MANUEL doldurulan Jira / Atlassian ────────────────────────────────────
# JIRA_BASE_URL ve JIRA_API_TOKEN alternatif adlardır; boş bırakılırsa
# config.py JIRA_URL ve JIRA_TOKEN değerlerini kullanır.
#JIRA_URL=https://kurumadi.atlassian.net
#JIRA_EMAIL=operator@example.com
#JIRA_TOKEN=<ATLASSIAN_API_TOKEN>
#JIRA_DEFAULT_PROJECT=SID
#JIRA_DEFAULT_LABEL=sidar-ai
#JIRA_BASE_URL=https://kurumadi.atlassian.net
#JIRA_API_TOKEN=<ATLASSIAN_API_TOKEN>

# ─── MANUEL doldurulan Microsoft Teams ─────────────────────────────────────
#TEAMS_WEBHOOK_URL=https://...

# ─── Opsiyonel broker URL'leri ─────────────────────────────────────────────
# Kimlik bilgisi içeren broker URL'lerini .env.advanced yerine burada tutun.
#SIDAR_REDIS_URL=redis://localhost:6379/0
#REDIS_URL=redis://localhost:6379/0
#RABBITMQ_URL=amqp://guest:guest@localhost/
#KAFKA_BOOTSTRAP_SERVERS=localhost:9092
