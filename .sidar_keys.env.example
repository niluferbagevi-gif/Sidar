# ~/.sidar_keys.env — Sidar kişisel gizli anahtar dosyası şablonu
#
# Kullanım:
#   1) Bu dosyayı repoya değil kullanıcı ev dizinine kopyalayın:
#        cp .sidar_keys.env.example ~/.sidar_keys.env
#   2) Sadece kullandığınız servislerin değerlerini doldurun.
#   3) Dosya izinlerini kısıtlayın:
#        chmod 600 ~/.sidar_keys.env
#
# Güvenlik:
#   - Bu dosyaya gerçek secret yazılır; Git'e commit etmeyin.
#   - Paylaşılan / sızmış görünen tokenları sağlayıcı panellerinden iptal edip yenileyin.
#   - Kullanmadığınız servisleri boş bırakabilir veya ilgili satırı silebilirsiniz.

# ─── Dosya yükleme ve temel çalışma modu ───────────────────────
# Bu dosyanın konumu. .env içinden override etmek isterseniz aynı değeri kullanın.
SIDAR_KEYS_FILE=~/.sidar_keys.env

# Varsayılan yerel sağlayıcı Ollama'dır. Harici sağlayıcı kullanacaksanız
# AI_PROVIDER değerini openai, anthropic, gemini veya litellm yapın.
AI_PROVIDER=ollama
CODING_MODEL=qwen2.5-coder:7b
TEXT_MODEL=gemma2:9b
OLLAMA_URL=http://localhost:11434/api

# ─── Manuel doldurulması gereken yerel güvenlik secretları ─────
# install_sidar.sh bu değerleri .env içinde üretebilir; ev dizinindeki bu dosyada
# tutmak istiyorsanız aşağıdaki değerleri güçlü rastgele değerlerle doldurun.
# Örnek üretim: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY=
JWT_SECRET_KEY=
MEMORY_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# Opsiyonel: doğrudan DSN vermek istiyorsanız doldurun; boşsa POSTGRES_* parçalarından üretilir.
DATABASE_URL=
SIDAR_CONTAINER_DATABASE_URL=

# ─── AI Sağlayıcıları ─────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_TIMEOUT=60

# LiteLLM gateway / OpenRouter uyumlu proxy kullanıyorsanız doldurun.
LITELLM_GATEWAY_URL=
LITELLM_API_KEY=
LITELLM_MODEL=
LITELLM_FALLBACK_MODELS=
LITELLM_TIMEOUT=60

# HuggingFace özel/gated model erişimi için.
HF_TOKEN=
HF_HUB_OFFLINE=false

# ─── GitHub ve Web Arama ──────────────────────────────────────
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_WEBHOOK_SECRET=

SEARCH_ENGINE=auto
TAVILY_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# ─── Slack ────────────────────────────────────────────────────
SLACK_TOKEN=
SLACK_APP_LEVEL_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_DEFAULT_CHANNEL=

# ─── Jira / Atlassian ─────────────────────────────────────────
# JIRA_BASE_URL ve JIRA_API_TOKEN alternatif adlardır; boş bırakılırsa
# config.py JIRA_URL ve JIRA_TOKEN değerlerini kullanır.
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_DEFAULT_PROJECT=
JIRA_DEFAULT_LABEL=sidar-ai
JIRA_BASE_URL=
JIRA_API_TOKEN=

# ─── Microsoft Teams ──────────────────────────────────────────
TEAMS_WEBHOOK_URL=

# ─── Otonomi / webhook paylaşılmış secretları ─────────────────
AUTONOMY_WEBHOOK_SECRET=
SWARM_FEDERATION_SHARED_SECRET=

# ─── Event bus / broker kimlikli URL'leri (opsiyonel) ─────────
# Kimlik bilgisi içeren broker URL'lerini .env.advanced yerine burada tutun.
SIDAR_REDIS_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost/
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
