# shellcheck shell=bash
# Sidar remote installer checksum defaults.
#
# This file is sourced by install_sidar.sh before uv, Ollama, Volta, or NVM remote
# installer scripts are downloaded. Use shell default assignments so explicit operator-provided
# environment variables always win:
#
#   OLLAMA_INSTALL_SHA256=<reviewed-hash> ./install_sidar.sh
#
# Keep these values empty unless the referenced remote installer content has been
# reviewed and the hash was produced from the exact reviewed bytes. The remote
# script endpoints below are mutable, so stale pins intentionally fail closed and
# must be refreshed by an operator or automation after review.

: "${OLLAMA_INSTALL_SHA256:=25f64b810b947145095956533e1bdf56eacea2673c55a7e586be4515fc882c9f}"
: "${UV_INSTALL_SHA256:=a7e3924ea1cd06bf1518c577d635c624ae2e2db030e0fc8ff8cf426224384e17}"
: "${VOLTA_INSTALL_SHA256:=fbdc4b8cb33fb6d19e5f07b22423265943d34e7e5c3d5a1efcecc9621854f9cb}"
: "${NVM_INSTALL_SHA256:=2d8359a64a3cb07c02389ad88ceecd43f2fa469c06104f92f98df5b6f315275f}"
