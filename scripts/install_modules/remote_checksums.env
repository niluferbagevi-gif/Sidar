# shellcheck shell=bash
# Sidar remote installer checksum defaults.
#
# This file is sourced by install_sidar.sh before uv/Ollama remote installer scripts
# are downloaded. Use shell default assignments so explicit operator-provided
# environment variables always win:
#
#   OLLAMA_INSTALL_SHA256=<reviewed-hash> ./install_sidar.sh
#
# Keep these values empty unless the referenced remote installer content has been
# reviewed and the hash was produced from the exact reviewed bytes. The remote
# script endpoints below are mutable, so stale pins intentionally fail closed and
# must be refreshed by an operator or automation after review.

: "${OLLAMA_INSTALL_SHA256:=}"
: "${UV_INSTALL_SHA256:=}"
: "${VOLTA_INSTALL_SHA256:=}"
: "${NVM_INSTALL_SHA256:=}"
