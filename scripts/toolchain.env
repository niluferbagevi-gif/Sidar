# Canonical Sidar development, CI, installer and container toolchain contract.
PYTHON_VERSION=3.11.15
PYTHON_MINOR=3.11
UV_VERSION=0.12.0
UV_IMAGE_DIGEST=sha256:606e70c71c852d03f611b1e56a195d08648507018a7057fab82c4974c4eae105
# Full patch pin, matching PYTHON_VERSION/UV_VERSION's reproducibility
# rigor above (a code review flagged this as major-only ("20") while its
# siblings in this same file were exact — inconsistent, not a deliberate
# choice). CI still separately exercises Node 22 compatibility via the
# non-blocking frontend-node-compatibility job in .github/workflows/ci.yml,
# so this pin doesn't reduce cross-version coverage; it only makes the
# *default* toolchain reproducible instead of "whatever 20.x happens to be
# installed/cached." Bump deliberately alongside security/LTS patch releases.
NODE_VERSION=20.20.2
# Playwright runtimes serve separate test surfaces and intentionally do not
# share browser binaries: Python drives backend/browser-manager integration,
# while Node drives web_ui_react E2E. Keep both ranges explicit and validate
# them through scripts/ci/check_toolchain_contract.py.
PLAYWRIGHT_PYTHON_MIN=1.62.0
PLAYWRIGHT_PYTHON_MAX=1.63
PLAYWRIGHT_NODE_MIN=1.60.0
PLAYWRIGHT_NODE_MAX=1.63.0
