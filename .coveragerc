[html]
extra_css = assets/dark_mode.css

[report]
# This is the *stable, achievable* daily local quality gate baseline. The
# coverage_ratchet helper raises this value upward as runs succeed but never
# lowers it; the local-profile ratchet cap (run_tests.sh) keeps it under 100
# so a small fluctuation does not red-line developer velocity. The %100
# aspirational target lives in the coverage-campaign profile
# (COVERAGE_CAMPAIGN=1 / AUTONOMOUS_LOOP_OPERATION_PROFILE=coverage-campaign),
# and CI uses its own stricter override via COVERAGE_FAIL_UNDER_CI.
fail_under = 99
