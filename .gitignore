secrets/
credentials/

# Backups & build artifacts
backups/
artifacts/
.benchmarks/

# Generated reports (kept as CI/job artifacts, not source-controlled)
coverage.json
coverage-final.json
coverage.xml
htmlcov/
reports/*.json
reports/*.xml
reports/*.txt
!reports/.gitkeep

# Logs
logs/
.devcontainer/logs/
*.log

# Temp
temp/
tmp/

# Runtime files
*.pid
*.sock

# Data (whitelist strategy: keep folder shape, ignore contents)
data/*
!data/.gitkeep

# Database
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite3
:memory:
:memory:-shm
:memory:-wal

# Sessions (sensitive user data)
sessions/

# Local documentation (keep in local workspace, do not push to GitHub)
# docs/
.note
*.note
*.todo

# Web vendor libraries (install_sidar.sh tarafından indirilir, repoya dahil edilmez)
web_ui/vendor/

