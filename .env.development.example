# ─────────────────────────────────────────────
# Sidar — Yerel geliştirme ortamı şablonu
#
# Kullanım:
#   cp .env.example .env
#   cp .env.development.example .env.development
#   SIDAR_ENV=development uv run python main.py
#
# Notlar:
# - .env.development git tarafından izlenmez; gerçek sırları yalnız o dosyada tutun.
# - DATABASE_URL ve container içi bağlantı config.py tarafından POSTGRES_* kök
#   değişkenlerinden türetilir; parola drift'i olmaması için bu dosyada tam DSN tutmayın.
# - Güçlü local secret/parolaları üretmek için: uv run sidar init
# ─────────────────────────────────────────────

SIDAR_ENV=development
AI_PROVIDER=ollama
CODING_MODEL=qwen2.5-coder:7b
OLLAMA_URL=http://localhost:11434/api
OLLAMA_TIMEOUT=600

# ─── PostgreSQL ──────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sidar
POSTGRES_USER=sidar
POSTGRES_PASSWORD=replace-with-a-strong-24-plus-character-password

# DATABASE_URL dinamik olarak şu köklerden türetilir:
# postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
# Docker Compose uygulama servisleri POSTGRES_HOST=postgres override'ı ile container içi
# bağlantıyı aynı kök değişkenlerden üretir. Self-heal varsayılanı ayrı SQLite kullanır;
# aynı PostgreSQL'i özellikle istiyorsanız SELF_HEAL_DATABASE_URL değerini runtime'da export edin.

DB_DEGRADED_MODE_ON_POSTGRES_FAILURE=true
DB_SCHEMA_VERSION_TABLE=schema_versions

# Yerel geliştirmede auth katmanı kapatılmasın diye sabit olmayan bir değer verin.
API_KEY=replace-with-a-local-development-api-key
ACCESS_LEVEL=sandbox
