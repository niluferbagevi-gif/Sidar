# ─────────────────────────────────────────────
# Sidar — Yerel geliştirme ortamı şablonu
#
# Kullanım:
#   cp .env.example .env
#   cp .env.development.example .env.development
#   SIDAR_ENV=development uv run python main.py
#
# Notlar:
# - .env.development git tarafından izlenmez; yine de gerçek servis anahtarları için
#   varsayılan kaynak ~/.sidar_keys.env dosyasıdır.
# - install_sidar.sh gerçek servis anahtarlarını env dosyalarına yalnız
#   SIDAR_MATERIALIZE_REAL_KEYS_TO_ENV=1 ile bilinçli opt-in yapılırsa yazar.
# - DATABASE_URL ve SIDAR_CONTAINER_DATABASE_URL aktif tanımlı değilse config.py
#   POSTGRES_* parçalarından otomatik DSN üretir. Böylece PostgreSQL parolası
#   yalnız POSTGRES_PASSWORD alanında tutulur.
# - Geliştirme veritabanı adı sidar_development olarak ayrılmıştır; üretim
#   veya temel .env içindeki POSTGRES_DB=sidar değeriyle aynı DB'yi paylaşmayın.
# - Güçlü parola üretmek için: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# ─────────────────────────────────────────────

SIDAR_ENV=development
AI_PROVIDER=ollama
CODING_MODEL=qwen2.5-coder:7b
OLLAMA_URL=http://localhost:11434/api
OLLAMA_TIMEOUT=600
# Yerel GPU/integration testlerinde gerçek eşzamanlılık için GPU_BENCH_CONCURRENCY ile hizalayın.
OLLAMA_NUM_PARALLEL=4
# Long prompt assertion fix: 8192 ctx ile llama.cpp n_batch=512 varsayılanına düşmemek için 2048.
OLLAMA_NUM_BATCH=2048
OLLAMA_NUM_CTX=8192
# CPU-only geliştirme için güvenli varsayılan. install_sidar.sh GPU tespit ederse .env içinde true yapar.
USE_GPU=false
REQUIRE_GPU=false

# Sandbox/izole pytest koşuları için proje Dockerfile imajını sabitleyin.
SIDAR_CODE_EXECUTION_BACKEND=docker
CODE_EXECUTION_BACKEND=docker
DOCKER_AUTODETECT=true
DOCKER_TEST_IMAGE=sidar:latest

# ─── VRAM Yönetimi ───────────────────────────
# LLM + RAG toplamı 1.0'ı aşarsa Sidar güvenli 0.8 toplamına normalize eder.
# WSL2 veya düşük VRAM'de RAG'a toplu belge yüklemeden önce bu değerleri düşürün.
GPU_MEMORY_FRACTION=0.8
LLM_GPU_MEMORY_FRACTION=0.6
RAG_GPU_MEMORY_FRACTION=0.3
GPU_MIXED_PRECISION=false

# ─── PostgreSQL ──────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_CONTAINER_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sidar_development
POSTGRES_USER=sidar
POSTGRES_PASSWORD=replace-with-a-strong-24-plus-character-password

DB_DEGRADED_MODE_ON_POSTGRES_FAILURE=true
DB_SCHEMA_VERSION_TABLE=schema_versions

# Yerel geliştirmede auth katmanı kapatılmasın diye sabit olmayan bir değer verin.
API_KEY=replace-with-a-local-development-api-key
JWT_SECRET_KEY=replace-with-a-local-development-jwt-secret-32-plus-chars
ACCESS_LEVEL=sandbox
PROMPT_GUARD_ENABLED=true
GUARDRAILS_REQUIRED=false
