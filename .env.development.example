# ─────────────────────────────────────────────
# Sidar — Yerel geliştirme ortamı şablonu
#
# Kullanım:
#   cp .env.example .env
#   cp .env.development.example .env.development
#   SIDAR_ENV=development uv run python main.py
#
# Notlar:
# - .env.development git tarafından izlenmez; gerçek sırları yalnız o dosyada tutun.
# - POSTGRES_PASSWORD, DATABASE_URL ve SIDAR_CONTAINER_DATABASE_URL içindeki parola
#   birebir aynı olmalıdır. Aksi halde PostgreSQL "password authentication failed"
#   hatası döndürür.
# - Güçlü parola üretmek için: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# ─────────────────────────────────────────────

SIDAR_ENV=development
AI_PROVIDER=ollama
CODING_MODEL=qwen2.5-coder:7b
OLLAMA_URL=http://localhost:11434/api
OLLAMA_TIMEOUT=600

# ─── PostgreSQL ──────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sidar
POSTGRES_USER=sidar
POSTGRES_PASSWORD=replace-with-a-strong-24-plus-character-password

# Yerel host bağlantısı: uygulamayı doğrudan WSL2/Linux üzerinde çalıştırırken kullanılır.
DATABASE_URL=postgresql+asyncpg://sidar:replace-with-a-strong-24-plus-character-password@localhost:5432/sidar

# Docker Compose iç ağ bağlantısı: uygulama container içindeyken `postgres` servis adını kullanır.
SIDAR_CONTAINER_DATABASE_URL=postgresql+asyncpg://sidar:replace-with-a-strong-24-plus-character-password@postgres:5432/sidar

# Self-heal belleği için ayrı DB vermiyorsanız ana geliştirme DB'siyle aynı kalabilir.
SELF_HEAL_DATABASE_URL=postgresql+asyncpg://sidar:replace-with-a-strong-24-plus-character-password@localhost:5432/sidar

DB_DEGRADED_MODE_ON_POSTGRES_FAILURE=true
DB_SCHEMA_VERSION_TABLE=schema_versions

# Yerel geliştirmede auth katmanı kapatılmasın diye sabit olmayan bir değer verin.
API_KEY=replace-with-a-local-development-api-key
ACCESS_LEVEL=sandbox
