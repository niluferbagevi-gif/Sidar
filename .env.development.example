# ─────────────────────────────────────────────
# Sidar — Yerel geliştirme ortamı şablonu
#
# Kullanım:
#   cp .env.example .env
#   cp .env.development.example .env.development
#   SIDAR_ENV=development uv run python main.py
#
# Notlar:
# - .env.development git tarafından izlenmez; gerçek sırları yalnız o dosyada tutun.
# - DATABASE_URL ve SIDAR_CONTAINER_DATABASE_URL boş bırakılırsa config.py bu
#   POSTGRES_* parçalarından otomatik DSN üretir. Böylece PostgreSQL parolası
#   yalnız POSTGRES_PASSWORD alanında tutulur.
# - Güçlü parola üretmek için: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# ─────────────────────────────────────────────

SIDAR_ENV=development
AI_PROVIDER=ollama
CODING_MODEL=qwen2.5-coder:7b
OLLAMA_URL=http://localhost:11434/api
OLLAMA_TIMEOUT=600
# Yerel GPU/integration testlerinde gerçek eşzamanlılık için GPU_BENCH_CONCURRENCY ile hizalayın.
OLLAMA_NUM_PARALLEL=4

# ─── PostgreSQL ──────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_CONTAINER_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sidar
POSTGRES_USER=sidar
POSTGRES_PASSWORD=replace-with-a-strong-24-plus-character-password

DB_DEGRADED_MODE_ON_POSTGRES_FAILURE=true
DB_SCHEMA_VERSION_TABLE=schema_versions

# Yerel geliştirmede auth katmanı kapatılmasın diye sabit olmayan bir değer verin.
API_KEY=replace-with-a-local-development-api-key
ACCESS_LEVEL=sandbox

# ─── VRAM Yönetimi (yerel LLM + RAG aynı GPU'yu paylaşırken) ──
# qwen2.5-coder:7b ve ChromaDB embedding'i aynı GPU'da çalıştığında VRAM
# bölüşülür. Aşağıdaki değerler .env.advanced varsayılanlarını override eder
# (yorum kalkık olduğu sürece). config.py LLM + RAG > 1.0 olursa otomatik
# normalize eder (target 0.8), ama bu OOM korumasıdır; uyarı logu üretir.
# Geliştirme makinesi profilleri:
#   - Yüksek VRAM ayrık GPU (≥16 GB) :  LLM=0.6  RAG=0.3   (toplam 0.9)
#   - Orta VRAM ayrık GPU (12 GB)    :  LLM=0.55 RAG=0.25  (toplam 0.8)
#   - WSL2 / düşük VRAM (8 GB)       :  LLM=0.40 RAG=0.20  (toplam 0.6)
#     (WSL2'de Windows host VRAM'ini paylaştığınız için daha düşük tutun.)
# GPU_MEMORY_FRACTION=0.8
# LLM_GPU_MEMORY_FRACTION=0.6
# RAG_GPU_MEMORY_FRACTION=0.3
# GPU_MIXED_PRECISION=false   # RTX 20xx+ kartlarda 'true' yapınca embedding daha az VRAM tüketir
